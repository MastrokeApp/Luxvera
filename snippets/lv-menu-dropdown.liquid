{% doc %}
  3-level standard (non-mega) dropdown panel for a top-level nav link.

  Level 1 — `link`      : the trigger, rendered by the caller (lv-nav__link-group)
  Level 2 — link.links  : primary dropdown items. Each item's label is a real
                           link; if it has its own children, a separate caret
                           button (not the label) toggles the level-3 flyout.
  Level 3 — child.links : rendered as a nested flyout submenu that opens to the
                           right of its parent item when that item is toggled

  @param {link} link - the top-level navigation link whose sub-menu to render

  @example
  {% render 'lv-menu-dropdown', link: link %}
{% enddoc %}

{% comment %} <div class="lv-dropdown">
  {%- for child in link.links -%}
    {%- if child.links.size > 0 -%}
      <div class="lv-dropdown__item" data-lv-submenu>
        <span class="lv-dropdown__link-group">
          <a class="lv-dropdown__link lv-dropdown__link--has-sub" href="{{ child.url }}">{{ child.title }}</a>
          <button type="button" class="lv-dropdown__caret" aria-haspopup="true" aria-expanded="false" aria-label="Toggle submenu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 6 15 12 9 18"/></svg>
          </button>
        </span>
        <div class="lv-dropdown__flyout">
          {%- for grandchild in child.links -%}
            <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <a class="lv-dropdown__link" href="{{ child.url }}">{{ child.title }}</a>
    {%- endif -%}
  {%- endfor -%}
</div> {% endcomment %}

{% doc %}
  3-level standard dropdown menu.

  Level 1:
  Top-level navigation link is rendered by the caller.

  Level 2:
  link.links are rendered as dropdown items.

  Level 3:
  child.links are rendered as flyout items on hover.

  @param {link} link
{% enddoc %}

<div class="lv-dropdown">

  {%- for child in link.links -%}

    {%- if child.links.size > 0 -%}

      <div class="lv-dropdown__item" data-lv-submenu>

        <span class="lv-dropdown__link-group">

          <!-- Level 2 link -->
          <a
            class="lv-dropdown__link lv-dropdown__link--has-sub"
            href="{{ child.url }}"
          >
            {{ child.title }}
          </a>

          <!-- Caret -->
          <button
            type="button"
            class="lv-dropdown__caret"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Toggle {{ child.title }} submenu"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <polyline points="9 6 15 12 9 18"></polyline>
            </svg>
          </button>

        </span>


        <!-- Level 3 -->
        <div class="lv-dropdown__flyout">

          {%- for grandchild in child.links -%}

            <a
              class="lv-dropdown__flyout-link"
              href="{{ grandchild.url }}"
            >
              {{ grandchild.title }}
            </a>

          {%- endfor -%}

        </div>

      </div>

    {%- else -%}

      <!-- Level 2 without children -->
      <a
        class="lv-dropdown__link"
        href="{{ child.url }}"
      >
        {{ child.title }}
      </a>

    {%- endif -%}

  {%- endfor -%}

</div>
{% unless section.settings.enable_mega_menu %}
<style>

/* =========================================
   LEVEL 2 DROPDOWN
========================================= */

.lv-dropdown {
  position: absolute;

  top: calc(100% + 1px);
  left: 0;

  min-width: 200px;

  padding: 8px 0;

  background: #fff;
  border: 1px solid rgba(0, 0, 0, 0.08);

  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10);

  z-index: 100;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateY(6px);

  transition:
    opacity .2s ease,
    transform .2s ease,
    visibility .2s ease;
}


/* =========================================
   OPEN TOP LEVEL DROPDOWN ON HOVER
========================================= */

@media screen and (min-width: 990px) {

  .lv-nav__item[data-lv-dropdown]:hover > .lv-dropdown,
  .lv-nav__item[data-lv-dropdown]:focus-within > .lv-dropdown {

    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
  }

}


/* =========================================
   LEVEL 2 ITEM
========================================= */

.lv-dropdown__item {
  position: relative;
  width: 100%;
}


/* =========================================
   LEVEL 2 LINK GROUP
========================================= */

.lv-dropdown__link-group {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;
}


/* =========================================
   LEVEL 2 LINK
========================================= */

.lv-dropdown__link {
  display: flex;
  align-items: center;

  width: 100%;

  padding: 12px 16px;

  color: rgb(var(--color-foreground));

  text-decoration: none;

  font-size: 14px;
  line-height: 1.4;

  white-space: nowrap;

  transition:
    background-color .2s ease,
    color .2s ease;
}

.lv-dropdown__link:hover {
  background: rgba(0, 0, 0, .04);
}


/* =========================================
   LEVEL 2 LINK WITH CHILDREN
========================================= */

.lv-dropdown__link-group .lv-dropdown__link {
  flex: 1;
  width: auto;
}


/* =========================================
   CARET
========================================= */

.lv-dropdown__caret {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 38px;
  min-width: 38px;
  height: 42px;

  padding: 0;

  border: 0;
  background: transparent;

  color: currentColor;

  cursor: pointer;
}

.lv-dropdown__caret svg {
  width: 14px;
  height: 14px;
}


/* =========================================
   LEVEL 3 FLYOUT
========================================= */

.lv-dropdown__flyout {
  position: absolute;

  top: -8px;
  left: calc(100% + 1px);

  min-width: 200px;

  padding: 8px 0;

  background: #fff;

  border: 1px solid rgba(0, 0, 0, 0.08);

  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.10);

  z-index: 110;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateX(6px);

  transition:
    opacity .2s ease,
    transform .2s ease,
    visibility .2s ease;
}


/* =========================================
   OPEN LEVEL 3 ON HOVER
========================================= */

@media screen and (min-width: 990px) {

  .lv-dropdown__item:hover > .lv-dropdown__flyout,
  .lv-dropdown__item:focus-within > .lv-dropdown__flyout {

    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateX(0);
  }

}


/* =========================================
   LEVEL 3 LINKS
========================================= */

.lv-dropdown__flyout-link {
  display: block;

  width: 100%;

  padding: 11px 16px;

  color: rgb(var(--color-foreground));

  text-decoration: none;

  font-size: 14px;
  line-height: 1.4;

  white-space: nowrap;

  transition:
    background-color .2s ease,
    color .2s ease;
}

.lv-dropdown__flyout-link:hover {
  background: rgba(0, 0, 0, .04);
}


/* =========================================
   DESKTOP
========================================= */

@media screen and (min-width: 990px) {

  .lv-nav__item[data-lv-dropdown] {
    position: relative;
  }

  .lv-dropdown__item {
    position: relative;
  }

}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 989px) {

  .lv-dropdown {
    position: static;

    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: none;

    box-shadow: none;
    border: 0;
  }

  .lv-dropdown__flyout {
    position: static;

    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: none;

    box-shadow: none;
    border: 0;
  }

}
  
</style>
{% endunless %}