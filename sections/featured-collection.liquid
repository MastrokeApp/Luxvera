{% comment %}
  Section: Featured Collection

  Swiper carousel of product-card snippets from a chosen collection, with a
  size-picker modal and AJAX add-to-cart. Falls back to placeholder cards when
  the collection is empty. Styles live in assets/dress-looks.css (shared with
  sections/product-recommendations.liquid); Swiper is loaded globally in
  theme.liquid.
{% endcomment %}

{{ 'lv-variant-modal.css' | asset_url | stylesheet_tag }}
{{ 'dress-looks.css' | asset_url | stylesheet_tag }}

{%- assign dl_col = section.settings.collection -%}
{%- assign products_limit = section.settings.products_limit | default: 8 -%}

{%- capture placeholder_cards -%}
  {%- comment -%} Prices in cents, formatted by the money filter. {%- endcomment -%}
  {%- assign placeholder_prices = '4900,5900,3900,6900,4500,5500,3500,7500' | split: ',' -%}
  {%- assign placeholder_old = '7900,8900,5900,9900,6500,8500,5500,10500' | split: ',' -%}
  {%- assign placeholder_svgs = 'product-1,product-2,product-3,product-4,product-1,product-2,product-3,product-4' | split: ',' -%}

  {%- for i in (0..7) -%}
    <div class="swiper-slide">
      <div class="product-card--placeholder">
        <div class="product-img-wrap" aria-hidden="true">
          {{ placeholder_svgs[i] | placeholder_svg_tag: 'placeholder-svg' }}
        </div>

        <div class="product-info">
          <span class="product-name">{{ 'products.placeholder_title' | t }}</span>
          <div class="price-color-row">
            <span class="price-new">{{ placeholder_prices[i] | times: 1 | money }}</span>
            <span class="price-old">{{ placeholder_old[i] | times: 1 | money }}</span>
          </div>
          <button class="add-to-cart" disabled aria-disabled="true">
            {%- if section.settings.atc_label != blank -%}{{ section.settings.atc_label }}{%- else -%}{{ 'products.add_to_cart' | t }}{%- endif -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}

<div class="lv-variant-modal" id="lv-vm-dl-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'products.select_size' | t }}">
  <div class="lv-variant-modal__box">
    <div class="lv-variant-modal__head">
      <span class="lv-variant-modal__title" id="lv-vm-dl-title-{{ section.id }}"></span>
      <button class="lv-variant-modal__close" id="lv-vm-dl-close-{{ section.id }}" aria-label="{{ 'accessibility.close' | t }}">&times;</button>
    </div>
    <p class="lv-variant-modal__label">{{ 'products.select_size' | t }}</p>
    <div class="lv-variant-modal__options" id="lv-vm-dl-opts-{{ section.id }}"></div>
    <p class="lv-variant-modal__error" id="lv-vm-dl-error-{{ section.id }}" role="alert" hidden></p>
    <button
      class="lv-variant-modal__atc"
      id="lv-vm-dl-atc-{{ section.id }}"
      data-label-choose="{{ 'products.choose_a_size' | t }}"
      data-label-add-prefix="{{ 'products.add_to_cart_prefix' | t }}"
      data-label-adding="{{ 'products.adding' | t }}"
      data-label-sold-out="{{ 'products.sold_out' | t }}"
      data-label-error="{{ 'products.add_to_cart_error' | t }}"
      disabled
    >{{ 'products.choose_a_size' | t }}</button>
  </div>
</div>

<div
  class="section dress-section color-{{ section.settings.color_scheme }}"
  id="dress-looks-{{ section.id }}"
  data-dl-id="{{ section.id }}"
  style="
    --dl-padding-top-desktop: {{ section.settings.padding_top_desktop | default: 64 }}px;
    --dl-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop | default: 64 }}px;
    --dl-padding-top-tablet: {{ section.settings.padding_top_tablet | default: 44 }}px;
    --dl-padding-bottom-tablet: {{ section.settings.padding_bottom_tablet | default: 44 }}px;
    --dl-padding-top-mobile: {{ section.settings.padding_top_mobile | default: 28 }}px;
    --dl-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile | default: 28 }}px;
    --dl-heading-align: {{ section.settings.heading_alignment | default: 'center' }};
    --dl-heading-size: {{ section.settings.heading_size | default: 32 }}px;
    --dl-heading-size-mobile: {{ section.settings.heading_size | default: 32 | times: 0.72 | round }}px;
    --dl-subtitle-size: {{ section.settings.subtitle_size | default: 13 }}px;
  "
>
  <div class="container">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="sec-head">
        {%- if section.settings.title != blank -%}
          <h2 class="sec-title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="sec-sub">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="swiper swiper-dresses-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- if dl_col != blank and dl_col.products.size > 0 -%}
          {%- for product in dl_col.products limit: products_limit -%}
            <div class="swiper-slide">
              {% render 'product-card',
                product: product,
                card_context: 'dress-looks',
                atc_label: section.settings.atc_label,
                image_ratio: 'portrait',
                priority: forloop.first
              %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {{ placeholder_cards }}
        {%- endif -%}
      </div>
    </div>

    <div class="swiper-nav">
      <button class="sw-prev" id="lv-dress-prev-{{ section.id }}" aria-label="{{ 'accessibility.previous' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <button class="sw-next" id="lv-dress-next-{{ section.id }}" aria-label="{{ 'accessibility.next' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{% javascript %}
(function () {
  'use strict';

  var BAG_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>';

  var instances = {};

  function cartAddUrl() {
    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    return root + 'cart/add.js';
  }

  function parseVariants(btn) {
    if (btn.dataset.variantsJson) {
      try { return JSON.parse(btn.dataset.variantsJson); } catch (e) {}
    }
    return (btn.dataset.variants || '').split('::').map(function (v) {
      var p = v.split('||');
      return { id: p[0], title: p[1], available: p[2] !== 'false' };
    });
  }

  function whenSwiperReady(cb) {
    if (typeof Swiper !== 'undefined') { cb(); return; }
    var n = 0;
    var t = setInterval(function () {
      if (typeof Swiper !== 'undefined') { clearInterval(t); cb(); }
      else if (++n > 60) { clearInterval(t); }
    }, 100);
  }

  function initDressLooks(root) {
    if (root.dataset.lvDlInit) return;
    root.dataset.lvDlInit = '1';

    var SID = root.dataset.dlId;

    var modal      = document.getElementById('lv-vm-dl-' + SID);
    var modalTitle = document.getElementById('lv-vm-dl-title-' + SID);
    var modalOpts  = document.getElementById('lv-vm-dl-opts-' + SID);
    var modalAtc   = document.getElementById('lv-vm-dl-atc-' + SID);
    var modalClose = document.getElementById('lv-vm-dl-close-' + SID);
    var modalError = document.getElementById('lv-vm-dl-error-' + SID);
    var selectedVid = null;
    var selectedTitle = '';
    var lastTrigger = null;
    var releaseModalTrap = null;

    function isModalOpen() {
      return !!(modal && modal.classList.contains('open'));
    }

    function setModalError(message) {
      if (!modalError) return;
      modalError.textContent = message || '';
      modalError.hidden = !message;
    }

    function openModal(btn) {
      if (!modal || !modalTitle || !modalOpts || !modalAtc) return;

      lastTrigger = btn;
      modalTitle.textContent = btn.dataset.productTitle || '';
      modalOpts.innerHTML = '';
      setModalError('');
      selectedVid = null;
      selectedTitle = '';
      modalAtc.disabled = true;
      modalAtc.textContent = modalAtc.dataset.labelChoose || 'Choose a size';

      parseVariants(btn).forEach(function (v) {
        if (!v || !v.id || !v.title) return;

        var opt = document.createElement('button');
        opt.type = 'button';
        opt.className = 'lv-variant-modal__opt';
        opt.textContent = v.title;

        if (!v.available) {
          opt.disabled = true;
          opt.title = modalAtc.dataset.labelSoldOut || 'Sold out';
        }

        opt.addEventListener('click', function () {
          if (opt.disabled) return;

          modalOpts.querySelectorAll('.lv-variant-modal__opt').forEach(function (o) {
            o.classList.remove('selected');
          });

          opt.classList.add('selected');
          selectedVid = String(v.id);
          selectedTitle = v.title;
          setModalError('');
          modalAtc.disabled = false;
          modalAtc.textContent = (modalAtc.dataset.labelAddPrefix || 'Add To Cart — ') + v.title;
        });

        modalOpts.appendChild(opt);
      });

      if (!isModalOpen()) document.body.style.overflow = 'hidden';
      modal.classList.add('open');
      if (releaseModalTrap) releaseModalTrap();
      if (window.lvTrapFocus) releaseModalTrap = window.lvTrapFocus(modal);
      setTimeout(function () {
        if (modalClose) modalClose.focus();
      }, 50);
    }

    // Pass false when the cart drawer is about to take focus.
    function closeModal(restoreFocus) {
      if (!isModalOpen()) return;
      modal.classList.remove('open');
      document.body.style.overflow = '';
      selectedVid = null;
      if (releaseModalTrap) { releaseModalTrap(); releaseModalTrap = null; }
      if (restoreFocus !== false && lastTrigger) lastTrigger.focus();
      lastTrigger = null;
    }

    if (modalClose) modalClose.addEventListener('click', function () { closeModal(); });
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
    }

    function showCardError(btn, message) {
      var info = btn.parentNode;
      if (!info) return;
      var el = info.querySelector('.dl-atc-error');
      if (!el) {
        el = document.createElement('p');
        el.className = 'dl-atc-error';
        el.setAttribute('role', 'alert');
        info.appendChild(el);
      }
      el.textContent = message;
      clearTimeout(el._lvTimer);
      el._lvTimer = setTimeout(function () {
        if (el.parentNode) el.parentNode.removeChild(el);
      }, 5000);
    }

    function addToCart(vid) {
      return fetch(cartAddUrl(), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          id: parseInt(vid, 10),
          quantity: 1
        })
      })
      .catch(function () { return null; })
      .then(function (r) {
        if (!r) throw new Error('');
        return r.json().catch(function () { return {}; }).then(function (data) {
          if (!r.ok || data.status) throw new Error(data.description || data.message || '');
          return data;
        });
      });
    }

    function announceAdded(vid) {
      document.dispatchEvent(new CustomEvent('cart:updated', {
        bubbles: true,
        detail: { variantId: vid }
      }));
      document.dispatchEvent(new CustomEvent('cart:open'));
    }

    function errorText(err) {
      return (err && err.message) || modalAtc && modalAtc.dataset.labelError || 'Could not add to cart.';
    }

    if (modalAtc) {
      modalAtc.addEventListener('click', function () {
        if (!selectedVid) return;

        var vid = selectedVid;
        var label = modalAtc.textContent;
        modalAtc.disabled = true;
        modalAtc.textContent = modalAtc.dataset.labelAdding || 'Adding…';
        setModalError('');

        addToCart(vid).then(function () {
          modalAtc.textContent = label;
          closeModal(false);
          announceAdded(vid);
        }, function (err) {
          modalAtc.disabled = false;
          modalAtc.textContent = label;
          setModalError(errorText(err));
        });
      });
    }

    var el = root.querySelector('.swiper-dresses-' + SID);
    if (!el) return;

    if (el.swiper) {
      el.swiper.destroy(true, true);
    }

    var sw = new Swiper(el, {
      grabCursor: true,
      loop: false,
      observer: true,
      observeParents: true,
      breakpoints: {
        0:    { slidesPerView: 1.2, spaceBetween: 12 },
        480:  { slidesPerView: 2,   spaceBetween: 14 },
        768:  { slidesPerView: 3,   spaceBetween: 16 },
        1024: { slidesPerView: 4,   spaceBetween: 20 }
      }
    });

    var prevBtn = document.getElementById('lv-dress-prev-' + SID);
    var nextBtn = document.getElementById('lv-dress-next-' + SID);

    if (prevBtn) prevBtn.onclick = function () { sw.slidePrev(); };
    if (nextBtn) nextBtn.onclick = function () { sw.slideNext(); };

    root.addEventListener('click', function (e) {
      var btn = e.target.closest('.add-to-cart');
      if (!btn || btn.disabled || btn.getAttribute('aria-disabled') === 'true') return;
      if (btn.classList.contains('adding') || btn.classList.contains('added')) return;

      var vid = btn.dataset.variantId,
          isMulti = btn.dataset.multi === 'true';

      if (isMulti) {
        openModal(btn);
        return;
      }

      if (!vid || vid === '' || vid === 'undefined') {
        window.location.href = btn.dataset.productUrl || '/';
        return;
      }

      var origHTML = btn.innerHTML;
      btn.classList.add('adding');
      btn.innerHTML = (btn.dataset.labelAdding || 'Adding…') + BAG_SVG;

      addToCart(vid).then(function () {
        btn.classList.remove('adding');
        btn.classList.add('added');
        btn.innerHTML = (btn.dataset.labelAdded || 'Added') + ' &#10003;' + BAG_SVG;

        setTimeout(function () {
          btn.innerHTML = origHTML;
          btn.classList.remove('added');
        }, 2200);

        announceAdded(vid);
      }, function (err) {
        btn.classList.remove('adding');
        btn.innerHTML = origHTML;
        showCardError(btn, errorText(err));
      });
    });

    instances[SID] = {
      root: root,
      isModalOpen: isModalOpen,
      closeModal: closeModal,
      destroy: function () {
        closeModal(false);
        if (sw && !sw.destroyed) sw.destroy(true, true);
      }
    };
  }

  function initAll(scope) {
    (scope || document).querySelectorAll('.dress-section').forEach(function (root) {
      whenSwiperReady(function () { initDressLooks(root); });
    });
  }

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    Object.keys(instances).forEach(function (sid) {
      if (instances[sid].isModalOpen()) instances[sid].closeModal();
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (e) {
    initAll(e.target);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    Object.keys(instances).forEach(function (sid) {
      if (e.target.contains(instances[sid].root)) {
        instances[sid].destroy();
        delete instances[sid];
      }
    });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "class": "luxvera-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "t:labels.padding_top_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "t:labels.padding_bottom_desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_tablet",
      "label": "t:labels.padding_top_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_tablet",
      "label": "t:labels.padding_bottom_tablet",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.section_title",
      "default": "Dress looks"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:labels.heading_font_size_2",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.heading_alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.heading_alignment.center"
        },
        {
          "value": "right",
          "label": "t:options.heading_alignment.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:labels.subtitle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:labels.subtitle",
      "default": "Some of our new looks you will love"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "t:labels.subtitle_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "t:labels.add_to_cart_button"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "t:labels.button_label_single_variant",
      "default": "Add To Cart"
    },
    {
      "type": "header",
      "content": "t:labels.products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "t:labels.max_products_to_show",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection",
      "category": "t:general.products"
    }
  ]
}
{% endschema %}
