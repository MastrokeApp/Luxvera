{% comment %}
  Section: Main Article (blog post detail page)

  Renders the full article -- featured image, title, author/date, rich
  content, share links, and comments (list + form) when enabled on the
  blog. Matches the site's design system (container width, color scheme,
  typography conventions used across product/collection/blog sections).

  Needs: main-article.css

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{{ 'main-article.css' | asset_url | stylesheet_tag }}

<div
  class="lv-article color-{{ section.settings.color_scheme }}"
  style="
    --lv-article-pt: {{ section.settings.padding_top }}px;
    --lv-article-pb: {{ section.settings.padding_bottom }}px;
    --lv-article-content-max: {{ section.settings.content_width }}px;
    --lv-article-radius: {{ section.settings.image_radius }}px;
  "
>
  <div class="lv-article__inner">

    {%- if section.settings.show_breadcrumb -%}
      <nav class="lv-article__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ blog.url }}">&larr; Back to {{ blog.title }}</a>
      </nav>
    {%- endif -%}

    {%- if article.image -%}
      <div class="lv-article__media">
        <img
          src="{{ article.image | image_url: width: 1600 }}"
          alt="{{ article.image.alt | escape | default: article.title }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      </div>
    {%- endif -%}

    <h1 class="lv-article__title">{{ article.title }}</h1>

    <div class="lv-article__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | time_tag: format: 'date' }}
      </time>
      {%- if article.author != blank -%}
        <span>By {{ article.author }}</span>
      {%- endif -%}
      {%- if blog.comments_enabled? -%}
        <span>{{ article.comments_count }} Comment{% if article.comments_count != 1 %}s{% endif %}</span>
      {%- endif -%}
    </div>

    <div class="lv-article__content rte">
      {{ article.content }}
    </div>

    {%- if section.settings.show_share -%}
      <div class="lv-article__share">
        <span class="lv-article__share-label">Share</span>
        <a class="lv-article__share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a class="lv-article__share-btn" href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}&description={{ article.title | url_encode }}" target="_blank" rel="noopener" aria-label="Share on Pinterest">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.4 9.3-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.6c0-1.5.9-2.6 1.9-2.6.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.5-.2 1 .5 1.9 1.6 1.9 1.9 0 3.1-2.4 3.1-5.2 0-2.2-1.5-3.7-3.6-3.7-2.4 0-3.8 1.8-3.8 3.7 0 .7.3 1.5.6 1.9.1.1.1.2.1.3l-.2 1c0 .2-.2.2-.3.1-1.1-.5-1.7-2.1-1.7-3.4 0-2.7 2-5.2 5.7-5.2 3 0 5.3 2.1 5.3 5 0 3-1.9 5.4-4.5 5.4-.9 0-1.7-.5-2-1l-.5 2.1c-.2.8-.7 1.7-1.1 2.3.8.3 1.7.4 2.6.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
        </a>
        <a class="lv-article__share-btn" href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}" aria-label="Share by email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </a>
      </div>
    {%- endif -%}

    {%- if blog.comments_enabled? -%}
      <div class="lv-article__comments" id="comments">
        <h2 class="lv-article__comments-heading">Comments</h2>

        {% paginate article.comments by 10 %}
          {%- if article.comments.size > 0 -%}
            {%- for comment in article.comments -%}
              <div class="lv-comment">
                <div class="lv-comment__head">
                  <span class="lv-comment__author">{{ comment.author }}</span>
                  <span class="lv-comment__date">{{ comment.created_at | time_tag: format: 'date' }}</span>
                </div>
                <p class="lv-comment__body">{{ comment.content }}</p>
              </div>
            {%- endfor -%}
          {%- else -%}
            <p class="lv-article__comments-empty">Be the first to comment.</p>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <div class="lv-article__comments-pagination">
              {{ paginate | default_pagination: anchor: 'comments' }}
            </div>
          {%- endif -%}
        {% endpaginate %}
      </div>

      {% form 'new_comment', article, class: 'lv-comment-form' %}
        <h2 class="lv-comment-form__heading">Leave a comment</h2>

        {%- if form.posted_successfully? -%}
          <div class="lv-comment-notice lv-comment-notice--success">
            {%- if blog.moderated? -%}
              Your comment was posted successfully. It's awaiting approval by the blog owner before it appears.
            {%- else -%}
              Your comment was posted successfully.
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="lv-comment-form__errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="lv-comment-form__row">
          <label for="CommentAuthor-{{ section.id }}">Name</label>
          <input type="text" name="comment[author]" id="CommentAuthor-{{ section.id }}" value="{{ form.author | escape }}" required>
        </div>

        <div class="lv-comment-form__row">
          <label for="CommentEmail-{{ section.id }}">Email</label>
          <input type="email" name="comment[email]" id="CommentEmail-{{ section.id }}" value="{{ form.email | escape }}" required>
        </div>

        <div class="lv-comment-form__row">
          <label for="CommentBody-{{ section.id }}">Comment</label>
          <textarea name="comment[body]" id="CommentBody-{{ section.id }}" required>{{ form.body | escape }}</textarea>
        </div>

        <button type="submit" class="lv-comment-form__submit">Post comment</button>
      {% endform %}
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "t:general.article",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 560,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1920
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show 'Back to blog' link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share links",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}