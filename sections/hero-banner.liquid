{% comment %}
  Section: Hero Banner

  Fading hero slideshow with autoplay, arrows, dots, touch swipe,
  per-slide image + overlay, and an empty-state placeholder.

  Settings architecture follows Shopify's slideshow convention:
  - Section settings control BEHAVIOUR shared by every slide
    (height, autoplay, accessibility label).
  - Block settings control APPEARANCE of that individual slide
    (colour scheme, content position/alignment, heading size,
    overlay, button style).

  Maximum 5 slides.
{% endcomment %}

{%- liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'

  assign has_slides = false
  if slide_blocks.size > 0
    assign has_slides = true
  endif

  assign slideshow_label = section.settings.slideshow_description
  if slideshow_label == blank
    assign slideshow_label = 'accessibility.hero_slideshow' | t
  endif
-%}

<div
  class="hero-slideshow"
  id="hero-banner-{{ section.id }}"
  style="
    --hero-height-desktop:{{ section.settings.height_desktop }}px;
    --hero-height-tablet:{{ section.settings.height_tablet }}px;
    --hero-height-mobile:{{ section.settings.height_mobile }}px;
  "
  role="region"
  aria-label="{{ slideshow_label | escape }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  {%- if has_slides -%}

    {%- for block in slide_blocks -%}
      {%- liquid
        assign is_first = false
        if forloop.index0 == 0
          assign is_first = true
        endif

        # Content position -> flexbox. Values are stored as "block_inline",
        # e.g. "middle_left", so one setting drives both axes.
        assign position_parts = block.settings.content_position | split: '_'
        assign position_block = position_parts[0]
        assign position_inline = position_parts[1]

        case position_block
          when 'top'
            assign justify_content = 'flex-start'
          when 'bottom'
            assign justify_content = 'flex-end'
          else
            assign justify_content = 'center'
        endcase

        case position_inline
          when 'left'
            assign align_items = 'flex-start'
          when 'right'
            assign align_items = 'flex-end'
          else
            assign align_items = 'center'
        endcase

        case block.settings.mobile_content_alignment
          when 'left'
            assign align_items_mobile = 'flex-start'
          when 'right'
            assign align_items_mobile = 'flex-end'
          else
            assign align_items_mobile = 'center'
        endcase

        # Placeholders cycle through the two valid lifestyle SVGs so slides
        # 3-5 can't throw "Unknown SVG placeholder" before an image is set.
        assign placeholder_index = forloop.index0 | modulo: 2 | plus: 1
        assign placeholder_name = 'lifestyle-' | append: placeholder_index

        assign button_variant = 'btn--primary'
        if block.settings.button_outline
          assign button_variant = 'btn--secondary'
        endif
      -%}

      <div
        class="hero-slide color-{{ block.settings.color_scheme }}{% if is_first %} is-active{% endif %}"
        {{ block.shopify_attributes }}
        style="
          --slide-overlay-color:{{ block.settings.overlay_color }};
          --slide-overlay-opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }};
          --hero-justify:{{ justify_content }};
          --hero-align:{{ align_items }};
          --hero-align-mobile:{{ align_items_mobile }};
          --hero-text-align:{{ block.settings.content_alignment }};
          --hero-text-align-mobile:{{ block.settings.mobile_content_alignment }};
          --hero-heading-size:{{ block.settings.heading_size }}px;
          --hero-heading-size-mobile:{{ block.settings.heading_size | times: 0.65 | round }}px;
        "
        aria-hidden="{% if is_first %}false{% else %}true{% endif %}"
      >
        <div class="hero-slide__bg">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1920 }}"
              alt="{{ block.settings.image.alt | default: block.settings.heading | default: shop.name | escape }}"
              class="hero-slide__img"
              loading="{% if is_first %}eager{% else %}lazy{% endif %}"
              {% if is_first %}fetchpriority="high"{% endif %}
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- else -%}
            <div class="hero-slide__placeholder">
              {{- placeholder_name | placeholder_svg_tag: 'hero-placeholder-svg' -}}
            </div>
          {%- endif -%}
          <div class="hero-slide__overlay"></div>
        </div>

        <div class="hero-slide__content">
          {%- if block.settings.heading != blank -%}
            {%- if template.name == 'index' -%}
              <h1 class="hero-slide__heading">{{ block.settings.heading | escape }}</h1>
            {%- else -%}
              <h2 class="hero-slide__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- endif -%}

          {%- if block.settings.subtext != blank -%}
            <p class="hero-slide__subtext">{{ block.settings.subtext | escape }}</p>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a
              href="{{ block.settings.button_url | default: '#' }}"
              class="btn {{ button_variant }} hero-slide__btn"
              {% if block.settings.button_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if slide_blocks.size > 1 -%}
      <button class="hero-arrow hero-arrow--prev" aria-label="{{ 'accessibility.previous_slide' | t }}" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>

      <button class="hero-arrow hero-arrow--next" aria-label="{{ 'accessibility.next_slide' | t }}" type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>

      <div class="hero-dots" role="tablist" aria-label="{{ 'accessibility.slide_navigation' | t }}">
        {%- for block in slide_blocks -%}
          <button
            class="hero-dot{% if forloop.index0 == 0 %} is-active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.index0 == 0 %}true{% else %}false{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
            data-index="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  {%- else -%}

    <div class="hero-slide is-active">
      <div class="hero-slide__bg">
        <div class="hero-slide__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-placeholder-svg' }}
        </div>
        <div class="hero-slide__overlay" style="--slide-overlay-color:#100a04;--slide-overlay-opacity:0.5;"></div>
      </div>
      <div class="hero-slide__content">
        <h2 class="hero-slide__heading">{{ 'hero_banner.add_first_slide' | t }}</h2>
        <p class="hero-slide__subtext">{{ 'hero_banner.add_first_slide_hint' | t }}</p>
      </div>
    </div>

  {%- endif -%}
</div>

{% stylesheet %}
.hero-slideshow {
  position: relative;
  height: var(--hero-height-desktop, 580px);
  overflow: clip;
}

.hero-slideshow .hero-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.7s ease;
  z-index: 0;
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
}

.hero-slideshow .hero-slide.is-active {
  opacity: 1;
  pointer-events: auto;
  z-index: 1;
}

.hero-slideshow .hero-slide__bg {
  position: absolute;
  inset: 0;
}

.hero-slideshow .hero-slide__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero-slideshow .hero-slide__placeholder {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: rgb(var(--color-background));
}

.hero-slideshow .hero-slide__placeholder .hero-placeholder-svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-slideshow .hero-slide__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    color-mix(in srgb, var(--slide-overlay-color, #100a04) calc(var(--slide-overlay-opacity, 0.6) * 100%), transparent) 32%,
    color-mix(in srgb, var(--slide-overlay-color, #100a04) calc(var(--slide-overlay-opacity, 0.1) * 10%), transparent) 100%
  );
}

.hero-slideshow .hero-slide__content {
  position: relative;
  z-index: 2;
  max-width: var(--lv-container-max, 1920px);
  margin: 0 auto;
  padding: 0 56px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: var(--hero-justify, center);
  align-items: var(--hero-align, flex-start);
  text-align: var(--hero-text-align, left);
}

@keyframes luxvera-fade-up {
  from {
    opacity: 0;
    transform: translateY(22px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-slideshow .hero-slide.is-active .hero-slide__heading {
  animation: luxvera-fade-up 0.7s ease both;
  animation-delay: 0.2s;
}

.hero-slideshow .hero-slide.is-active .hero-slide__subtext {
  animation: luxvera-fade-up 0.7s ease both;
  animation-delay: 0.38s;
}

.hero-slideshow .hero-slide.is-active .hero-slide__btn {
  animation: luxvera-fade-up 0.7s ease both;
  animation-delay: 0.52s;
}

.hero-slideshow .hero-slide__heading {
  color: rgb(var(--color-foreground));
  font-size: var(--hero-heading-size, 48px);
  font-weight: 500;
  line-height: 1.15;
  margin: 0 0 20px;
  max-width: 720px;
}

.hero-slideshow .hero-slide__subtext {
  color: rgb(var(--color-foreground));
  font-size: 18px;
  margin: 0;
  max-width: 480px;
  opacity: 0.88;
}

/**
 * Button appearance (height, padding, type, colours, hover) is owned by
 * .btn / .btn--primary / .btn--secondary in assets/component-button.css
 * so every section matches. Only layout/spacing stays here.
 */
.hero-slideshow .hero-slide__btn {
  margin-top: 36px;
}

.hero-slideshow .hero-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  background: rgba(var(--color-background), 0.35);
  border: 1px solid rgba(var(--color-foreground), 0.25);
  color: rgb(var(--color-foreground));
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.25s, transform 0.25s;
  backdrop-filter: blur(4px);
}

.hero-slideshow .hero-arrow:hover {
  background: rgba(var(--color-background), 0.55);
  transform: translateY(-50%) scale(1.08);
}

.hero-slideshow .hero-arrow--prev {
  left: 24px;
}

.hero-slideshow .hero-arrow--next {
  right: 24px;
}

.hero-slideshow .hero-dots {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  gap: 8px;
  align-items: center;
}

.hero-slideshow .hero-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(var(--color-foreground), 0.45);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background 0.3s, transform 0.3s;
}

.hero-slideshow .hero-dot.is-active {
  background: rgb(var(--color-foreground));
  transform: scale(1.35);
}

@media (max-width: 768px) {
  .hero-slideshow {
    height: var(--hero-height-tablet, 420px);
  }

  .hero-slideshow .hero-slide__content {
    padding: 0 28px;
  }

  .hero-slideshow .hero-arrow {
    width: 40px;
    height: 40px;
  }

  .hero-slideshow .hero-arrow--prev {
    left: 12px;
  }

  .hero-slideshow .hero-arrow--next {
    right: 12px;
  }
}

@media (max-width: 480px) {
  .hero-slideshow {
    height: var(--hero-height-mobile, 360px);
  }

  .hero-slideshow .hero-slide__content {
    padding: 0 24px;
    align-items: var(--hero-align-mobile, flex-start);
    text-align: var(--hero-text-align-mobile, left);
  }

  .hero-slideshow .hero-slide__heading {
    font-size: var(--hero-heading-size-mobile, 31px);
    margin-bottom: 16px;
  }

  .hero-slideshow .hero-slide__subtext {
    font-size: 15px;
    line-height: 1.6;
  }

  .hero-slideshow .hero-slide__btn {
    margin-top: 28px;
  }

  .hero-slideshow .hero-arrow {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-slideshow .hero-slide {
    transition: none;
  }

  .hero-slideshow .hero-slide.is-active .hero-slide__heading,
  .hero-slideshow .hero-slide.is-active .hero-slide__subtext,
  .hero-slideshow .hero-slide.is-active .hero-slide__btn {
    animation: none;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  'use strict';

  function setActive(root, index) {
    var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-slide'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('.hero-dot'));

    slides.forEach(function (slide, i) {
      var active = i === index;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', active ? 'false' : 'true');

      if (dots[i]) {
        dots[i].classList.toggle('is-active', active);
        dots[i].setAttribute('aria-selected', active ? 'true' : 'false');
      }
    });
  }

  function initHeroSlideshow(root) {
    if (!root || root.dataset.lvHeroInit) return;
    root.dataset.lvHeroInit = '1';

    var total = root.querySelectorAll('.hero-slide').length;
    if (total <= 1) return;

    var prev = root.querySelector('.hero-arrow--prev');
    var next = root.querySelector('.hero-arrow--next');
    var dots = Array.prototype.slice.call(root.querySelectorAll('.hero-dot'));

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0;
    var autoplay = root.dataset.autoplay === 'true' && !prefersReducedMotion;
    var speed = parseInt(root.dataset.speed, 10) || 5000;
    var timer = null;

    function goTo(index) {
      current = (index + total) % total;
      setActive(root, current);
    }

    function startAuto() {
      if (!autoplay) return;
      clearInterval(timer);
      timer = setInterval(function () {
        goTo(current + 1);
      }, speed);
    }

    function stopAuto() {
      clearInterval(timer);
    }

    function step(delta) {
      stopAuto();
      goTo(current + delta);
      startAuto();
    }

    if (prev) {
      prev.addEventListener('click', function () {
        step(-1);
      });
    }

    if (next) {
      next.addEventListener('click', function () {
        step(1);
      });
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        stopAuto();
        goTo(parseInt(dot.dataset.index, 10));
        startAuto();
      });
    });

    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);

    var touchStartX = 0;

    root.addEventListener('touchstart', function (e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    root.addEventListener('touchend', function (e) {
      var diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 40) {
        step(diff > 0 ? 1 : -1);
      }
    }, { passive: true });

    // Let the theme editor pause autoplay and jump between slides
    root.lvHeroStop = stopAuto;
    root.lvHeroGoTo = goTo;

    startAuto();
  }

  function initAll(scope) {
    (scope || document).querySelectorAll('.hero-slideshow').forEach(initHeroSlideshow);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      initAll();
    });
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (e) {
    initAll(e.target);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    var root = e.target.querySelector('.hero-slideshow');
    if (root && typeof root.lvHeroStop === 'function') root.lvHeroStop();
  });

  // Show the slide being edited when it is selected in the theme editor
  document.addEventListener('shopify:block:select', function (e) {
    var slide = e.target.closest('.hero-slide');
    var root = slide && slide.closest('.hero-slideshow');
    if (!root) return;

    var slides = Array.prototype.slice.call(root.querySelectorAll('.hero-slide'));
    var index = slides.indexOf(slide);
    if (index === -1) return;

    if (typeof root.lvHeroStop === 'function') root.lvHeroStop();

    if (typeof root.lvHeroGoTo === 'function') {
      root.lvHeroGoTo(index);
    } else {
      setActive(root, index);
    }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.hero_banner",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "class": "luxvera-hero-banner",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.section_height_2"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "t:labels.desktop_height_2",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 580
    },
    {
      "type": "range",
      "id": "height_tablet",
      "label": "t:labels.tablet_height_2",
      "min": 240,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "t:labels.mobile_height_2",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "header",
      "content": "t:labels.autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.auto_rotate_slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:labels.speed_seconds",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "slideshow_description",
      "label": "Slideshow description",
      "info": "Describe the slideshow for those using screen readers."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        {
          "type": "header",
          "content": "t:labels.background"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.background_image",
          "info": "t:labels.recommended_1920_1080px_jpg_webp_leave"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "t:labels.overlay_colour",
          "default": "#100a04"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:labels.overlay_opacity_2",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 60
        },
        {
          "type": "header",
          "content": "t:labels.content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Western Soul, Modern Style"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "t:labels.heading_font_size_2",
          "min": 28,
          "max": 96,
          "step": 2,
          "unit": "px",
          "default": 48
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "t:labels.subtext",
          "default": "From laid-back daytime to summer nights — discover Western style crafted for you."
        },
        {
          "type": "header",
          "content": "t:labels.button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "info": "Leave blank to hide the button.",
          "default": "Shop the Collection"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "t:labels.button_url"
        },
        {
          "type": "checkbox",
          "id": "button_outline",
          "label": "Outline style",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "button_open_new_tab",
          "label": "t:labels.open_in_new_tab",
          "default": false
        },
        {
          "type": "header",
          "content": "t:labels.layout"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "top_left", "label": "Top left" },
            { "value": "top_center", "label": "Top center" },
            { "value": "top_right", "label": "Top right" },
            { "value": "middle_left", "label": "Middle left" },
            { "value": "middle_center", "label": "Middle center" },
            { "value": "middle_right", "label": "Middle right" },
