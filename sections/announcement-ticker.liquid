{% comment %}
  Section: Announcement Ticker (Marquee)

  Seamless scrolling ticker bar.

  - Background and text colour come from the theme colour schemes
    (settings_schema.json -> color_schemes), applied via the
    `color-{scheme}` class, the same way sections/announcement-bar.liquid
    does it. No hard-coded background or text colour settings.
  - Vertical spacing is split into Padding top / Padding bottom and is
    scaled to 75% on mobile, matching Dawn's section padding convention.
  - The row is duplicated by JS until it overflows the viewport, so the
    loop never shows a blank gap.
  - If the visitor prefers reduced motion, the ticker renders as a single
    static, horizontally centred row instead of scrolling.
{% endcomment %}

{%- assign items = section.blocks | where: "type", "ticker_item" -%}

{%- if items.size > 0 -%}
  <div
    class="ticker color-{{ section.settings.color_scheme }}"
    id="ticker-{{ section.id }}"
    role="region"
    aria-label="{{ 'accessibility.announcements' | t }}"
    style="
      --ticker-sep-color: {{ section.settings.separator_color }};
      --ticker-speed: {{ section.settings.scroll_speed }}s;
      --ticker-size: {{ section.settings.font_size }}px;
      --ticker-padding-top: {{ section.settings.padding_top }}px;
      --ticker-padding-bottom: {{ section.settings.padding_bottom }}px;
      --ticker-padding-top-mobile: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      --ticker-padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    "
  >
    <div class="ticker-track">
      <div class="ticker-group">
        {%- for block in items -%}
          <span class="ticker-item" {{ block.shopify_attributes }}>
            {{- block.settings.text | escape -}}
          </span>
          {%- if section.settings.separator_char != blank -%}
            <span class="ticker-sep" aria-hidden="true">{{- section.settings.separator_char | escape -}}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
.luxvera-announcement-ticker .ticker {
  position: relative;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  background: var(--gradient-background, rgb(var(--color-background)));
  color: rgb(var(--color-foreground));
  padding-top: var(--ticker-padding-top-mobile, 9px);
  padding-bottom: var(--ticker-padding-bottom-mobile, 9px);
}

@media screen and (min-width: 750px) {
  .luxvera-announcement-ticker .ticker {
    padding-top: var(--ticker-padding-top, 12px);
    padding-bottom: var(--ticker-padding-bottom, 12px);
  }
}

.luxvera-announcement-ticker .ticker-track {
  display: flex;
  align-items: center;
  width: max-content;
}

.luxvera-announcement-ticker .ticker.is-loaded .ticker-track {
  animation: luxvera-ticker-scroll var(--ticker-speed, 25s) linear infinite;
  will-change: transform;
}

/* Pause on hover and on keyboard focus. */
.luxvera-announcement-ticker .ticker.is-loaded:hover .ticker-track,
.luxvera-announcement-ticker .ticker.is-loaded:focus-within .ticker-track {
  animation-play-state: paused;
}

/* Static mode: one row, no animation, content centred in the bar. */
.luxvera-announcement-ticker .ticker.is-static .ticker-track {
  width: 100%;
  justify-content: center;
  flex-wrap: wrap;
  animation: none;
}

.luxvera-announcement-ticker .ticker.is-static .ticker-sep:last-child {
  display: none;
}

.luxvera-announcement-ticker .ticker-group {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.luxvera-announcement-ticker .ticker.is-static .ticker-group {
  flex-wrap: wrap;
  justify-content: center;
}

.luxvera-announcement-ticker .ticker-item {
  font-size: var(--ticker-size, 13px);
  font-weight: 400;
  letter-spacing: 0.02em;
  color: inherit;
  padding: 0 28px;
  flex-shrink: 0;
}

.luxvera-announcement-ticker .ticker-sep {
  color: var(--ticker-sep-color, currentColor);
  font-size: calc(var(--ticker-size, 13px) + 1px);
  flex-shrink: 0;
  padding: 0 4px;
  user-select: none;
}

@keyframes luxvera-ticker-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(calc(-1 * var(--ticker-shift, 50%)));
  }
}

@media (prefers-reduced-motion: reduce) {
  .luxvera-announcement-ticker .ticker-track {
    animation: none !important;
    width: 100%;
    justify-content: center;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  'use strict';

  var SELECTOR = '.luxvera-announcement-ticker .ticker';

  // Remember each ticker's pristine single-group markup so rebuilds are clean.
  var originals = new WeakMap();

  function prefersReducedMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function buildTicker(root) {
    var track = root.querySelector('.ticker-track');
    if (!track) return;

    // Reset to one pristine group before measuring.
    track.innerHTML = originals.get(root);
    root.classList.remove('is-loaded', 'is-static');

    // Reduced motion: leave a single centred, non-scrolling row.
    if (prefersReducedMotion()) {
      root.classList.add('is-static');
      return;
    }

    var group = track.querySelector('.ticker-group');
    if (!group) return;

    var groupWidth = group.getBoundingClientRect().width;
    var containerWidth = root.getBoundingClientRect().width;
    if (groupWidth === 0 || containerWidth === 0) return;

    // Enough copies that the row always overflows the viewport - no blank gap.
    // Needs (copies - 1) * groupWidth >= containerWidth.
    var copies = Math.ceil(containerWidth / groupWidth) + 1;
    if (copies < 2) copies = 2;

    for (var i = 1; i < copies; i++) {
      var clone = group.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    }

    // Scroll exactly one group width -> the next identical group lands in
    // place, so the reset is invisible (seamless loop).
    root.style.setProperty('--ticker-shift', groupWidth + 'px');
    root.classList.add('is-loaded');
  }

  function initTicker(root) {
    if (!originals.has(root)) {
      var track = root.querySelector('.ticker-track');
      if (!track) return;
      originals.set(root, track.innerHTML);
    }
    requestAnimationFrame(function () { buildTicker(root); });
  }

  function initAll(scope) {
    var node = scope || document;
    node.querySelectorAll(SELECTOR).forEach(initTicker);
    // shopify:section:load hands us the section element itself.
    if (node.matches && node.matches(SELECTOR)) initTicker(node);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }

  // Web fonts change text width after load - re-measure once they're ready.
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function () { initAll(); });
  }

  // Re-measure on resize (debounced).
  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () { initAll(); }, 200);
  });

  // Rebuild if the visitor's motion preference changes.
  if (window.matchMedia) {
    var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    var onMotionChange = function () { initAll(); };
    if (motionQuery.addEventListener) {
      motionQuery.addEventListener('change', onMotionChange);
    } else if (motionQuery.addListener) {
      motionQuery.addListener(onMotionChange);
    }
  }

  // Theme editor: rebuild when the section is re-rendered.
  document.addEventListener('shopify:section:load', function (e) {
    initAll(e.target);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.announcement_ticker",
  "tag": "div",
  "class": "luxvera-announcement-ticker",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "t:labels.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "t:labels.separator_colour",
      "default": "#999999"
    },
    {
      "type": "text",
      "id": "separator_char",
      "label": "t:labels.separator_character",
      "default": "|",
      "info": "t:labels.character_shown_between_ticker_items"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:labels.font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "t:labels.animation"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "t:labels.scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 25,
      "info": "t:labels.lower_faster_higher_slower"
    },
    {
      "type": "header",
      "content": "t:labels.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "t:general.ticker_message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.message",
          "default": "GRAB The Deal Upto 80% Off & Extra 15% Off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.announcement_ticker",
      "category": "t:general.promotional",
      "blocks": [
        {
          "type": "ticker_item",
          "settings": {
            "text": "GRAB The Deal Upto 80% Off & Extra 15% Off"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "Free Shipping on all orders"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "New arrivals every week - shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
