{% comment %}
  Section: Rich Text

  Flexible block-based rich text section (eyebrow, heading, text, divider,
  button). Colors follow the selected color scheme. Padding/width/typography
  settings are passed as CSS custom properties so the section renders
  correctly even with multiple instances on the same page.
{% endcomment %}

<section
  id="rich-text-{{ section.id }}"
  class="lv-rich-text color-{{ section.settings.color_scheme }}"
  style="
    --lv-rt-pt: {{ section.settings.padding_top }}px;
    --lv-rt-pb: {{ section.settings.padding_bottom }}px;
    --lv-rt-pt-m: {{ section.settings.padding_top_mobile }}px;
    --lv-rt-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --lv-rt-max-width: {{ section.settings.max_width }}px;
    --lv-rt-content-width: {{ section.settings.content_width }}px;
    --lv-rt-text-align: {{ section.settings.text_alignment }};
    --lv-rt-text-size: {{ section.settings.text_size }}px;
    --lv-rt-text-size-m: {{ section.settings.text_size_mobile }}px;
    --lv-rt-btn-radius: {{ section.settings.button_radius }}px;
  "
>
  <div class="lv-rich-text__container">

    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'eyebrow' -%}
          {%- if block.settings.text != blank -%}
            <p class="lv-rich-text__eyebrow" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </p>
          {%- endif -%}

        {%- when 'heading' -%}
          {%- if block.settings.heading != blank -%}
            <{{ block.settings.heading_tag }}
              class="lv-rich-text__heading lv-rich-text__heading--{{ block.settings.size }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading | escape }}
            </{{ block.settings.heading_tag }}>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.content != blank -%}
            <div class="lv-rich-text__content rte" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>
          {%- endif -%}

        {%- when 'divider' -%}
          <div class="lv-rich-text__divider" role="presentation" aria-hidden="true" {{ block.shopify_attributes }}>
            <span></span>
          </div>

        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <div class="lv-rich-text__button-wrapper" {{ block.shopify_attributes }}>
              
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                class="lv-rich-text__button"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                {{ block.settings.label | escape }}
              </a>
            </div>
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}

  </div>
</section>

{% stylesheet %}
.lv-rich-text {
  width: 100%;
  padding-top: var(--lv-rt-pt, 60px);
  padding-bottom: var(--lv-rt-pb, 60px);
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
}

.lv-rich-text__container {
  width: 100%;
  max-width: var(--lv-rt-max-width, 1920px);
  margin: 0 auto;
  padding: 0 56px;
  box-sizing: border-box;
  text-align: var(--lv-rt-text-align, center);
}

/* Eyebrow */
.lv-rich-text__eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin: 0 0 14px;
  color: rgb(var(--color-foreground));
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  opacity: 0.72;
}

.lv-rich-text__eyebrow::before,
.lv-rich-text__eyebrow::after {
  content: "";
  width: 30px;
  height: 1px;
  background: currentColor;
  opacity: 0.55;
}

/* Heading */
.lv-rich-text__heading {
  max-width: 100%;
  margin: 0 auto 20px;
  color: rgb(var(--color-foreground));
  font-family: var(--lv-font-heading, serif);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  overflow-wrap: break-word;
  word-break: break-word;
}

.lv-rich-text__heading--small {
  font-size: 30px;
}

.lv-rich-text__heading--medium {
  font-size: 42px;
}

.lv-rich-text__heading--large {
  font-size: 56px;
}

/* Rich text content */
.lv-rich-text__content {
  max-width: var(--lv-rt-content-width, 1920px);
  margin: 0 auto;
  color: rgb(var(--color-foreground));
  font-size: var(--lv-rt-text-size, 16px);
  line-height: 1.75;
  opacity: 0.78;
}

.lv-rich-text__content p {
  margin: 0 0 16px;
}

.lv-rich-text__content p:last-child {
  margin-bottom: 0;
}

.lv-rich-text__content h1,
.lv-rich-text__content h2,
.lv-rich-text__content h3,
.lv-rich-text__content h4 {
  margin-top: 25px;
  margin-bottom: 12px;
}

.lv-rich-text__content a {
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}

.lv-rich-text__content ul,
.lv-rich-text__content ol {
  max-width: 100%;
  margin: 15px auto;
  padding-left: 25px;
  text-align: left;
}

/* Divider */
.lv-rich-text__divider {
  width: 100%;
  max-width: 100px;
  margin: 28px auto;
}

.lv-rich-text__divider span {
  display: block;
  width: 100%;
  height: 1px;
  background: rgba(var(--color-foreground), 0.25);
}

/* Button */
.lv-rich-text__button-wrapper {
  margin-top: 28px;
}

.lv-rich-text__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 145px;
  min-height: 48px;
  padding: 0 25px;
  border-radius: var(--lv-rt-btn-radius, 2px);
  background: rgb(var(--color-button));
  color: rgb(var(--color-button-text));
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.lv-rich-text__button:hover {
  opacity: 0.85;
  transform: translateY(-1px);
}

/* Tablet */
@media screen and (max-width: 1024px) {
  .lv-rich-text__container {
    padding: 0 32px;
  }
}

/* Mobile */
@media screen and (max-width: 749px) {
  .lv-rich-text {
    padding-top: var(--lv-rt-pt-m, 45px);
    padding-bottom: var(--lv-rt-pb-m, 45px);
  }

  .lv-rich-text__container {
    padding: 0 20px;
  }

  .lv-rich-text__eyebrow {
    font-size: 10px;
    letter-spacing: 0.18em;
  }

  .lv-rich-text__eyebrow::before,
  .lv-rich-text__eyebrow::after {
    width: 20px;
  }

  .lv-rich-text__heading--small {
    font-size: 24px;
  }

  .lv-rich-text__heading--medium {
    font-size: 30px;
  }

  .lv-rich-text__heading--large {
    font-size: 38px;
  }

  .lv-rich-text__content {
    font-size: var(--lv-rt-text-size-m, 14px);
  }

  .lv-rich-text__button {
    width: 100%;
  }
}

@media screen and (max-width: 480px) {
  .lv-rich-text__container {
    padding: 0 16px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "class": "section-rich-text",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.text_alignment.left" },
        { "value": "center", "label": "t:options.text_alignment.center" },
        { "value": "right", "label": "t:options.text_alignment.right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section maximum width",
      "min": 800,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1920
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text content width",
      "min": 400,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1920
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:labels.body_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Mobile text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "t:labels.button_border_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "t:labels.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:labels.padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:labels.padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.eyebrow_text",
          "default": "Our story"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Designed for your everyday"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:labels.heading_tag",
          "options": [
            { "value": "h1", "label": "t:options.heading_tag.h1" },
            { "value": "h2", "label": "t:options.heading_tag.h2" },
            { "value": "h3", "label": "t:options.heading_tag.h3" }
          ],
          "default": "h2",
          "info": "Use H1 only if this is the main heading on the page."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Heading size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "medium"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.body_text",
          "default": "<p>Discover thoughtfully designed pieces created to make every day feel effortless. Explore our collection and find something made for you.</p>"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": []
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.button_label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.button_url"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "t:labels.open_in_new_tab_2",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}