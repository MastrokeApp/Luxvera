{{ 'lv-currency.css' | asset_url | stylesheet_tag }}
{{ 'lv-header.css' | asset_url | stylesheet_tag }}

<script src="{{ 'lv-currency.js' | asset_url }}" defer></script>
<script src="{{ 'lv-header.js' | asset_url }}" defer></script>

<div class="lv-header-wrap{% if section.settings.sticky %} lv-header-wrap--sticky{% endif %}">

  {%- if section.settings.show_top_bar -%}
  <div class="lv-top-bar color-{{ section.settings.top_bar_color_scheme }}">
    <div class="lv-top-bar__inner">
      {% render 'currency-switcher', position: 'topbar' %}
    </div>
  </div>

  {%- endif -%}

  <!-- HEADER -->
  <header
    class="lv-header color-{{ section.settings.header_color_scheme }}"
    id="lv-header-{{ section.id }}"
    style="--lv-hdr-height:{{ section.settings.header_height }}px;"
  >
    <nav class="lv-nav lv-nav--logo-{{ section.settings.logo_position }}" aria-label="{{ 'accessibility.main_navigation' | t }}">
      <div class="lv-nav__left{% if section.settings.logo_position == 'left' %} lv-nav__left--{{ section.settings.nav_alignment }}{% endif %}">
        <button class="lv-hamburger" id="lvHamburger" aria-label="{{ 'accessibility.open_menu' | t }}" aria-expanded="false" aria-controls="lvMobileMenu"><span></span><span></span><span></span></button>
        <div class="lv-nav__links">
          {%- for link in linklists[section.settings.menu].links -%}
            {%- if forloop.first -%}
              <div class="lv-nav__item lv-nav__item--home">
                <a class="lv-nav__link lv-nav__link--icon" href="{{ link.url | default: routes.root_url }}" aria-label="{% if link.title != blank %}{{ link.title }}{% else %}{{ 'accessibility.home' | t }}{% endif %}">
                  {{ 'icon-home.svg' | inline_asset_content }}
                </a>
              </div>
            {%- elsif link.links.size > 0 -%}
              {%- assign is_mega = false -%}
              {%- if section.settings.enable_mega_menu -%}
                {%- assign is_mega = true -%}
              {%- endif -%}
              <div class="lv-nav__item" data-lv-dropdown>
                <span class="lv-nav__link-group">
                  <a class="lv-nav__link" href="{{ link.url }}">{{ link.title }}</a>
                  <button
                    type="button"
                    class="lv-nav__caret"
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label="Toggle submenu"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </button>
                </span>
                {%- if is_mega -%}
                  {% render 'lv-menu-mega', link: link %}
                {%- else -%}
                  {% render 'lv-menu-dropdown', link: link %}
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="lv-nav__item">
                <a class="lv-nav__link" href="{{ link.url }}">{{ link.title }}</a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <a href="{{ routes.root_url }}" class="lv-logo" aria-label="{{ shop.name }} home">
        {%- if settings.logo != blank -%}
          {%- assign logo_display_height = 48 -%}
          {%- assign logo_display_width = logo_display_height | times: settings.logo.aspect_ratio | round -%}
          {%- assign logo_width_2x = logo_display_width | times: 2 -%}
          {%- assign logo_width_3x = logo_display_width | times: 3 -%}
          <img
            src="{{ settings.logo | image_url: width: logo_display_width }}"
            srcset="
              {{ settings.logo | image_url: width: logo_display_width }} 1x,
              {{ settings.logo | image_url: width: logo_width_2x }} 2x,
              {{ settings.logo | image_url: width: logo_width_3x }} 3x
            "
            alt="{{ shop.name }}"
            width="{{ logo_display_width }}"
            height="{{ logo_display_height }}"
            loading="eager"
          >
        {%- else -%}
          <span class="lv-logo__name">{{ section.settings.brand_name | default: shop.name | upcase }}</span>
          <div class="lv-logo__sub-row"><span class="lv-logo__line"></span><span class="lv-logo__sub">{{ section.settings.brand_tagline | default: 'Fashion' }}</span><span class="lv-logo__line"></span></div>
        {%- endif -%}
      </a>

      <div class="lv-nav__right">
        <button class="lv-icon-btn" id="lvSearchBtn" aria-label="{{ 'accessibility.search' | t }}">
           {{ 'icon-search.svg' | inline_asset_content }} </button>
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account menu="customer-account-main-menu" class="lv-icon-btn">
            <div slot="signed-out-avatar" aria-label="{{ 'accessibility.account' | t }}">{{ 'icon-account.svg' | inline_asset_content }}</div>
          </shopify-account>
        {%- else -%}
          <a href="{{ routes.account_url }}" class="lv-icon-btn" aria-label="{{ 'accessibility.account' | t }}">
            {{ 'icon-account.svg' | inline_asset_content }}</a>
        {%- endif -%}

{% if settings.cart_type == 'page' %}

  <a href="{{ routes.cart_url }}"
     class="lv-icon-btn lv-icon-btn--cart"
     aria-label="{{ 'accessibility.cart' | t }}">

      {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}

    {% if cart.item_count > 0 %}
      <span class="lv-cart-badge">{{ cart.item_count }}</span>
    {% endif %}

  </a>

{% else %}

  <button
    type="button"
    class="lv-icon-btn lv-icon-btn--cart js-cart-drawer-open"
    aria-label="{{ 'accessibility.cart' | t }}">

      {% if cart == empty %}
           <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}

    {% if cart.item_count > 0 %}
      <span class="lv-cart-badge">{{ cart.item_count }}</span>
    {% endif %}

  </button>

{% endif %}
      </div>
    </nav>
  </header>
</div>

<!-- MOBILE DRAWER -->
<div class="lv-mobile-menu" id="lvMobileMenu" aria-hidden="true">
  <div class="lv-mobile-drawer color-{{ section.settings.header_color_scheme }}">
    <div class="lv-drawer-head">
      {%- if settings.logo != blank -%}
        {%- assign drawer_logo_height = 36 -%}
        {%- assign drawer_logo_width = drawer_logo_height | times: settings.logo.aspect_ratio | round -%}
        <img
          class="lv-drawer-logo"
          src="{{ settings.logo | image_url: width: drawer_logo_width }}"
          alt="{{ shop.name }}"
          width="{{ drawer_logo_width }}"
          height="{{ drawer_logo_height }}"
          loading="lazy"
        >
      {%- else -%}
        <span class="lv-drawer-logo">{{ section.settings.brand_name | default: shop.name | upcase }}</span>
      {%- endif -%}
      <button class="lv-drawer-close" id="lvDrawerClose" aria-label="{{ 'accessibility.close_menu' | t }}">✕</button>
    </div>
    <nav class="lv-drawer-nav">
      {%- for link in linklists[section.settings.menu].links -%}
        <div class="lv-drawer-item">
          {%- if link.links.size > 0 -%}
            <span class="lv-drawer-link-group">
              <a class="lv-drawer-link" href="{{ link.url }}">{{ link.title }}</a>
              <button type="button" class="lv-drawer-caret" data-lv-drawer-toggle aria-expanded="false" aria-label="Toggle submenu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </span>
            <div class="lv-drawer-sub">
              {%- for child in link.links -%}
                {%- if child.links.size > 0 -%}
                  <div class="lv-drawer-item">
                    <span class="lv-drawer-link-group">
                      <a class="lv-drawer-link" href="{{ child.url }}">{{ child.title }}</a>
                      <button type="button" class="lv-drawer-caret" data-lv-drawer-toggle aria-expanded="false" aria-label="Toggle submenu">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"/></svg>
                      </button>
                    </span>
                    <div class="lv-drawer-sub">
                      {%- for grandchild in child.links -%}
                        <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- else -%}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <a class="lv-drawer-link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>
    <div class="lv-drawer-footer">
      {% render 'currency-switcher', position: 'mobile' %}
      {%- if shop.customer_accounts_enabled -%}
        <shopify-account menu="customer-account-main-menu" class="lv-drawer-account">
          <div slot="signed-out-avatar" class="lv-drawer-account__signed-out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {{ 'header.my_account' | t }}
          </div>
        </shopify-account>
      {%- else -%}
        <a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>{{ 'header.my_account' | t }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- SEARCH OVERLAY -->
<div class="lv-search-overlay" id="lvSearchOverlay" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.search' | t }}">
  <div class="lv-search-panel">
    <div class="lv-search-box color-{{ section.settings.header_color_scheme }}">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search products, styles, collections…' }}" id="lvSearchInput" autocomplete="off" aria-label="{{ 'accessibility.search' | t }}">
      </form>
      <button class="lv-search-close" id="lvSearchClose" aria-label="{{ 'accessibility.close_search' | t }}">✕</button>
    </div>
    <div class="lv-predictive color-{{ section.settings.header_color_scheme }}" id="lvPredictiveResults" hidden></div>
  </div>
</div>



{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "t:labels.top_bar"
    },
    {
      "type": "checkbox",
      "id": "show_top_bar",
      "label": "t:labels.show_top_bar",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "top_bar_color_scheme",
      "label": "t:labels.top_bar_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.appearance"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "t:labels.brand_name",
      "default": "LUXVERA"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "t:labels.brand_tagline",
      "default": "Fashion"
    },
    {
      "type": "color_scheme",
      "id": "header_color_scheme",
      "label": "t:labels.header_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "t:labels.logo_position",
      "options": [
        { "value": "center", "label": "t:options.logo_position.center" },
        { "value": "left", "label": "t:options.logo_position.left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "nav_alignment",
      "label": "t:labels.nav_alignment",
      "options": [
        { "value": "left", "label": "t:options.nav_alignment.left" },
        { "value": "center", "label": "t:options.nav_alignment.center" },
        { "value": "right", "label": "t:options.nav_alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "t:labels.header_height",
      "min": 56,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:labels.sticky_header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mega_menu",
      "label": "t:labels.enable_mega_menu",
      "default": false
    },
    {
      "type": "header",
      "content": "t:labels.navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.main_menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:labels.search"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "t:labels.search_placeholder",
      "default": "Search products, styles, collections…"
    }
  ]
  
}
{% endschema %}