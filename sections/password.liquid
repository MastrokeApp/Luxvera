{% comment %}
  This section is used in the password template to render the landing page
  shown when password protection is applied to a store.

  Styling comes from --lv-color-*/--lv-font-* (snippets/css-variables,
  rendered by layout/password.liquid) rather than the per-section color
  scheme system, since layout/password.liquid doesn't extend theme.liquid
  and never generates the --color-background/--color-foreground tokens.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="lv-password full-width">
  <div class="lv-password__inner">

    <a href="{{ routes.root_url }}" class="lv-password__logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_height = 56 -%}
        {%- assign logo_width = logo_height | times: settings.logo.aspect_ratio | round -%}
        <img
          src="{{ settings.logo | image_url: width: logo_width }}"
          alt="{{ shop.name }}"
          width="{{ logo_width }}"
          height="{{ logo_height }}"
          loading="eager"
        >
      {%- else -%}
        <span class="lv-password__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="lv-password__content">
      <p class="lv-password__eyebrow">{{ 'password.opening_soon' | t }}</p>
      <h1 class="lv-password__title">{{ 'password.title' | t }}</h1>

      {%- if shop.password_message != blank -%}
        <div class="lv-password__message">{{ shop.password_message | newline_to_br }}</div>
      {%- endif -%}
    </div>

    <div class="lv-password__panel">
      {%- form 'storefront_password', class: 'lv-password__form' -%}
        {%- if form.errors -%}
          <div class="lv-password__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <label class="lv-password__label" for="lv-password-input">{{ 'password.password' | t }}</label>
        <div class="lv-password__field">
          <input
            type="password"
            name="password"
            id="lv-password-input"
            class="lv-password__input"
            autocomplete="current-password"
            required
          >
          <button type="submit" class="lv-password__submit">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </div>

    {%- if section.settings.show_email_capture -%}
      <div class="lv-password__notify">
        <h2 class="lv-password__notify-heading">{{ section.settings.notify_heading | escape }}</h2>
        {%- if section.settings.notify_text != blank -%}
          <p class="lv-password__notify-text">{{ section.settings.notify_text | escape }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'lv-password__notify-form' -%}
          <input type="hidden" name="contact[tags]" value="prospect, password page">

          {%- if form.posted_successfully? -%}
            <p class="lv-password__notify-success">{{ section.settings.success_message | escape }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <div class="lv-password__error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="lv-password__field">
              <label class="visually-hidden" for="lv-password-email">{{ section.settings.email_placeholder | escape }}</label>
              <input
                type="email"
                name="contact[email]"
                id="lv-password-email"
                class="lv-password__input"
                placeholder="{{ section.settings.email_placeholder | escape }}"
                autocomplete="email"
                required
              >
              <button type="submit" class="lv-password__submit lv-password__submit--outline">{{ section.settings.button_label | escape }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_social_icons -%}
      <div class="lv-password__social">
        {% render 'social-media-link' %}
      </div>
    {%- endif -%}

    {%- if section.settings.show_admin_link -%}
      <a class="lv-password__admin-link" href="/admin">{{ 'password.admin_link' | t }}</a>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
.lv-password {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 20px;
  box-sizing: border-box;
  background: var(--lv-color-bg);
  color: var(--lv-color-text);
}

.lv-password__inner {
  width: 100%;
  max-width: 440px;
  text-align: center;
}

.lv-password__logo {
  display: inline-flex;
  margin-bottom: 32px;
  text-decoration: none;
}

.lv-password__logo img {
  display: block;
  max-width: 200px;
  max-height: 56px;
  width: auto;
  height: auto;
}

.lv-password__logo-text {
  font-family: var(--lv-font-heading);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--lv-color-text);
}

.lv-password__eyebrow {
  margin: 0 0 10px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  opacity: 0.6;
}

.lv-password__title {
  margin: 0 0 16px;
  font-family: var(--lv-font-heading);
  font-size: 32px;
  line-height: 1.2;
}

.lv-password__message {
  margin: 0 0 32px;
  font-size: 15px;
  line-height: 1.7;
  opacity: 0.8;
}

.lv-password__panel {
  padding: 28px 28px 8px;
  margin-bottom: 32px;
  border: 1px solid var(--lv-color-border);
  border-radius: 12px;
  background: var(--lv-color-bg-alt);
}

.lv-password__label {
  display: block;
  margin-bottom: 8px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: left;
  opacity: 0.7;
}

.lv-password__field {
  display: flex;
  align-items: stretch;
  gap: 8px;
}

.lv-password__input {
  flex: 1;
  min-width: 0;
  padding: 13px 14px;
  font-family: var(--lv-font-body);
  font-size: 14px;
  color: var(--lv-color-text);
  background: var(--lv-color-bg);
  border: 1px solid var(--lv-color-border);
  border-radius: var(--lv-btn-radius, 6px);
  box-sizing: border-box;
}

.lv-password__input:focus {
  outline: none;
  border-color: var(--lv-color-primary);
}

.lv-password__submit {
  flex: 0 0 auto;
  padding: 0 22px;
  min-height: 44px;
  border: none;
  border-radius: var(--lv-btn-radius, 6px);
  background: var(--lv-color-primary);
  color: var(--lv-color-bg);
  font-family: var(--lv-font-body);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity 0.2s;
}

.lv-password__submit:hover {
  opacity: 0.85;
}

.lv-password__submit--outline {
  background: transparent;
  color: var(--lv-color-primary);
  border: 1px solid var(--lv-color-primary);
}

.lv-password__error {
  margin-bottom: 16px;
  padding: 10px 14px;
  border-radius: 6px;
  background: rgba(179, 38, 30, 0.08);
  color: #b3261e;
  font-size: 13px;
  text-align: left;
}

.lv-password__error ul {
  margin: 0;
  padding-left: 18px;
}

.lv-password__notify {
  margin-bottom: 32px;
}

.lv-password__notify-heading {
  margin: 0 0 6px;
  font-family: var(--lv-font-heading);
  font-size: 18px;
}

.lv-password__notify-text {
  margin: 0 0 16px;
  font-size: 13px;
  opacity: 0.7;
}

.lv-password__notify-success {
  margin: 0;
  font-size: 13px;
  color: var(--lv-color-primary);
}

.lv-password__social {
  margin-bottom: 24px;
}

.lv-password__social .social-row {
  display: flex;
  justify-content: center;
  gap: 10px;
}

.lv-password__social .social-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--lv-color-border);
  color: var(--lv-color-text);
  transition: opacity 0.2s;
}

.lv-password__social .social-btn:hover {
  opacity: 0.7;
}

.lv-password__social .social-btn svg {
  width: 16px;
  height: 16px;
}

.lv-password__admin-link {
  display: inline-block;
  font-size: 12px;
  color: var(--lv-color-text);
  opacity: 0.55;
  text-decoration: underline;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media screen and (max-width: 480px) {
  .lv-password__field {
    flex-direction: column;
  }

  .lv-password__panel {
    padding: 22px 18px 8px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_email_capture",
      "label": "t:labels.show_email_signup",
      "default": true
    },
    {
      "type": "text",
      "id": "notify_heading",
      "label": "t:labels.heading",
      "default": "Be the first to know"
    },
    {
      "type": "text",
      "id": "notify_text",
      "label": "t:labels.body_text",
      "default": "Sign up to be notified when we launch."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "t:labels.email_placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:labels.thank_you_message",
      "default": "Thanks! We'll let you know when we launch."
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "t:labels.show_social_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_admin_link",
      "label": "t:labels.show_admin_link",
      "default": true
    }
  ]
}
{% endschema %}
