{% comment %}
  Section: Trust Badges

  Row of trust badges (icon + title + text) as editor blocks. Each badge can
  use an uploaded icon or falls back to a built-in SVG based on its position.
  Ships pre-filled via presets. Colours follow the selected color scheme.

  Cards per row (3/4/5/6) sets the desktop grid column count; Cards per row
  (mobile) (1/2, default 1) sets it for mobile. When Enable Slider is off,
  the grid always collapses to a single column on mobile regardless of that
  mobile setting.

  Enable Slider turns the grid into a swipe/scroll carousel (dots + arrows,
  built on native CSS scroll-snap and progressively enhanced) on both
  desktop and mobile, using the two cards-per-row settings above to size
  each slide. The dots/arrows are built by JS from the actual number of
  cards visible per view, so if a cards-per-row setting is >= the total
  number of badges, everything already fits and the nav stays hidden.
{% endcomment %}

<div
  class="trust-section color-{{ section.settings.color_scheme }} gradient"
  id="trust-{{ section.id }}"
  data-slider="{{ section.settings.enable_slider }}"
  data-cards-per-row="{{ section.settings.cards_per_row }}"
  style="
    --trust-pt: {{ section.settings.padding_top | default: 48 }}px;
    --trust-pb: {{ section.settings.padding_bottom | default: 48 }}px;
    --trust-cols: {{ section.settings.cards_per_row | default: 4 }};
    --trust-cols-mobile: {{ section.settings.cards_per_row_mobile | default: 1 }};
  "
>
  <div class="trust-container">
    <div class="trust-grid">
      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          <div class="trust-icon">
  {% if block.settings.icon != blank %}
    {{
      block.settings.icon
      | image_url: width: 80
      | image_tag:
        loading: 'lazy',
        alt: block.settings.title,
        class: 'trust-icon-image'
    }}
  {% else %}
    {%- case forloop.index -%}
      {%- when 1 -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>

      {%- when 2 -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13" rx="1"/>
          <path d="M16 8h4l3 5v3h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>

      {%- when 3 -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
          <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/>
          <path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
        </svg>

      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
    {%- endcase -%}
  {% endif %}
</div>
          <h4>{{ block.settings.title | escape }}</h4>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.enable_slider and section.blocks.size > 1 -%}
      <div class="trust-slider-nav">
        <button type="button" class="trust-arrow trust-arrow--prev" aria-label="{{ 'accessibility.previous' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>

        {%- comment -%}
          Dots are built by JS (one per visible "page" of cards, not one per
          card) because how many cards fit per page depends on the live
          viewport width and the desktop/mobile cards-per-row settings.
        {%- endcomment -%}
        <div class="trust-dots"></div>

        <button type="button" class="trust-arrow trust-arrow--next" aria-label="{{ 'accessibility.next' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.trust-section {
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
  padding-top: var(--trust-pt, 48px);
  padding-bottom: var(--trust-pb, 48px);
}

.trust-section .trust-container {
  max-width: var(--lv-container-max, 1920px);
  margin: 0 auto;
  padding: 0 56px;
}

.trust-section .trust-grid {
  display: grid;
  grid-template-columns: repeat(var(--trust-cols, 4), 1fr);
  row-gap: 32px;
}

.trust-section .trust-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 8px 48px;
  border-left: 1px solid rgba(var(--color-foreground), 0.12);
}

.trust-section .trust-item:last-child {
  padding-right: 0;
}

/* First card of each row has no left divider/padding - scoped per column count so it works whichever row a card wraps onto */
.trust-section[data-cards-per-row="3"] .trust-item:nth-child(3n+1),
.trust-section[data-cards-per-row="4"] .trust-item:nth-child(4n+1),
.trust-section[data-cards-per-row="5"] .trust-item:nth-child(5n+1),
.trust-section[data-cards-per-row="6"] .trust-item:nth-child(6n+1) {
  border-left: none;
  padding-left: 0;
}

/* Slider mode - horizontal scroll-snap carousel on every breakpoint */
.trust-section[data-slider="true"] .trust-grid {
  display: flex;
  grid-template-columns: none;
  flex-wrap: nowrap;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  row-gap: 0;
}

.trust-section[data-slider="true"] .trust-grid::-webkit-scrollbar {
  display: none;
}

.trust-section[data-slider="true"] .trust-item {
  flex: 0 0 calc(100% / var(--trust-cols, 4));
  box-sizing: border-box;
  scroll-snap-align: start;
  border-left: 1px solid rgba(var(--color-foreground), 0.12);
}

.trust-section[data-slider="true"] .trust-item:first-child {
  border-left: none;
  padding-left: 0;
}

.trust-section.trust-js[data-slider="true"] .trust-slider-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 32px;
}

.trust-section .trust-icon {
  width: 36px;
  height: 36px;
  margin-bottom: 14px;
  color: rgb(var(--color-foreground));
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-section .trust-icon svg {
  width: 36px !important;
  height: 36px !important;
  stroke-width: 1.4;
  display: block;
  flex-shrink: 0;
}

.trust-section .trust-item h4 {
  font-size: calc(var(--lv-heading-scale, 1) * 15px);
  font-weight: 600;
  margin-bottom: 6px;
  color: rgb(var(--color-foreground));
}

.trust-section .trust-item p {
  font-size: calc(var(--lv-font-scale, 1) * 13px);
  color: rgb(var(--color-foreground));
  opacity: 0.6;
  line-height: 1.6;
}

/* Slider navigation (dots + arrows) — hidden until slider is enabled + JS */
.trust-section .trust-slider-nav {
  display: none;
}

.trust-section .trust-arrow {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(var(--color-foreground), 0.2);
  background: transparent;
  color: rgb(var(--color-foreground));
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: opacity .2s, background .2s;
}

.trust-section .trust-arrow svg {
  width: 16px;
  height: 16px;
  display: block;
}

.trust-section .trust-arrow:disabled {
  opacity: 0.3;
  cursor: default;
}

.trust-section .trust-dots {
  display: flex;
  align-items: center;
  gap: 8px;
}

.trust-section .trust-dot {
  width: 8px;
  height: 8px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgb(var(--color-foreground));
  opacity: 0.25;
  cursor: pointer;
  transition: opacity .2s, transform .2s;
}

.trust-section .trust-dot.is-active {
  opacity: 1;
  transform: scale(1.25);
}

@media (max-width: 1024px) {
  .trust-section .trust-container {
    padding: 0 32px;
  }
}

@media (max-width: 768px) {
  .trust-section .trust-container {
    padding: 0 20px;
  }

  /* Grid mode (slider disabled): single column, stacked, centered */
  .trust-section:not([data-slider="true"]) .trust-grid {
    grid-template-columns: 1fr;
    row-gap: 0;
  }

  .trust-section:not([data-slider="true"]) .trust-item {
    padding: 20px 0;
    border-left: none !important;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
    align-items: center;
    text-align: center;
  }

  .trust-section:not([data-slider="true"]) .trust-item:first-child {
    border-top: none;
    padding-top: 0;
  }

  /* Slider mode: --trust-cols-mobile cards at a time via CSS scroll-snap */
  .trust-section[data-slider="true"] .trust-item {
    flex: 0 0 calc(100% / var(--trust-cols-mobile, 1));
    border-left: none !important;
    padding: 8px 0;
  }

  .trust-section.trust-js[data-slider="true"] .trust-slider-nav {
    margin-top: 22px;
  }
}

@media (max-width: 480px) {
  .trust-section .trust-container {
    padding: 0 16px;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  'use strict';

  function initTrust(root) {
    if (root.dataset.lvTrustInit) return;

    var nav = root.querySelector('.trust-slider-nav');
    var grid = root.querySelector('.trust-grid');
    var dotsWrap = root.querySelector('.trust-dots');
    if (!nav || !grid || !dotsWrap) return; // only slider-enabled sections render nav

    root.dataset.lvTrustInit = '1';
    root.classList.add('trust-js');

    var items = Array.prototype.slice.call(root.querySelectorAll('.trust-item'));
    var prev = root.querySelector('.trust-arrow--prev');
    var next = root.querySelector('.trust-arrow--next');
    if (items.length === 0) return;

    var perView = 1;
    var itemWidth = 0;
    var pageCount = 1;
    var activePage = 0;
    var dots = [];
    var scrollTimer = null;
    var resizeTimer = null;

    // How many cards are actually visible at once right now - depends on
    // the live viewport width, not just the desktop/mobile setting values.
    function getPerView() {
      itemWidth = items[0].getBoundingClientRect().width;
      if (!itemWidth) return 1;
      return Math.max(1, Math.round(grid.clientWidth / itemWidth));
    }

    function buildDots() {
      dotsWrap.innerHTML = '';
      dots = [];
      for (var p = 0; p < pageCount; p++) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'trust-dot' + (p === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (p + 1));
        dot.addEventListener('click', (function (page) {
          return function () { goToPage(page); };
        })(p));
        dotsWrap.appendChild(dot);
        dots.push(dot);
      }
    }

    function setActivePage(p) {
      activePage = Math.max(0, Math.min(p, pageCount - 1));
      dots.forEach(function (d, di) { d.classList.toggle('is-active', di === activePage); });
      if (prev) prev.disabled = activePage <= 0;
      if (next) next.disabled = activePage >= pageCount - 1;
    }

    // While a button/dot click is driving a smooth scroll, the scroll-snap
    // container fires its own scroll events as it settles. If the debounced
    // listener below recomputes the active page from an in-between
    // scrollLeft, it can undo the page we just navigated to - which is what
    // made "Next" look like it re-triggered "Previous" and needed a second
    // click. This window suppresses that recalculation until the
    // programmatic scroll has had time to finish.
    var ignoreScrollUntil = 0;

    function goToPage(p) {
      p = Math.max(0, Math.min(p, pageCount - 1));
      var targetIndex = Math.min(p * perView, items.length - 1);
      ignoreScrollUntil = Date.now() + 600;
      grid.scrollTo({ left: items[targetIndex].offsetLeft, behavior: 'smooth' });
      setActivePage(p);
    }

    // Recompute how many "pages" of cards there are for the current
    // viewport. When every card already fits in one view (cards per row
    // >= total cards), there's nothing to page through, so hide the nav.
    function recalculate() {
      perView = getPerView();
      pageCount = Math.max(1, Math.ceil(items.length / perView));
      nav.style.display = pageCount <= 1 ? 'none' : '';
      buildDots();
      setActivePage(0);
    }

    if (prev) prev.addEventListener('click', function () { goToPage(activePage - 1); });
    if (next) next.addEventListener('click', function () { goToPage(activePage + 1); });

    // Track the active page as the user swipes/scrolls (not while a click
    // above is still settling its own programmatic scroll).
    grid.addEventListener('scroll', function () {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function () {
        if (Date.now() < ignoreScrollUntil) return;
        if (!itemWidth) return;
        var index = Math.round(grid.scrollLeft / itemWidth);
        setActivePage(Math.round(index / perView));
      }, 100);
    }, { passive: true });

    function onResize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(recalculate, 150);
    }
    window.addEventListener('resize', onResize);

    recalculate();
    root._lvTrustCleanup = function () {
      clearTimeout(scrollTimer);
      clearTimeout(resizeTimer);
      window.removeEventListener('resize', onResize);
    };
  }

  function initAll(scope) {
    (scope || document).querySelectorAll('.trust-section[data-slider="true"]').forEach(initTrust);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (e) {
    initAll(e.target);
  });

  document.addEventListener('shopify:section:unload', function (e) {
    var root = e.target.querySelector ? e.target.querySelector('.trust-section') : null;
    if (root && root._lvTrustCleanup) {
      root._lvTrustCleanup();
      root._lvTrustCleanup = null;
    }
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.trust_badges_2",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "class": "luxvera-trust",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.section_padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "cards_per_row",
      "label": "t:labels.cards_per_row",
      "default": "4",
      "options": [
        { "value": "3", "label": "t:options.cards_per_row.3" },
        { "value": "4", "label": "t:options.cards_per_row.4" },
        { "value": "5", "label": "t:options.cards_per_row.5" },
        { "value": "6", "label": "t:options.cards_per_row.6" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "t:labels.enable_slider",
      "info": "t:labels.slide_shows_a_swipeable_carousel_with",
      "default": false
    },
    {
      "type": "select",
      "id": "cards_per_row_mobile",
      "label": "t:labels.cards_per_row_mobile",
      "default": "1",
      "options": [
        { "value": "1", "label": "t:options.cards_per_row_mobile.1" },
        { "value": "2", "label": "t:options.cards_per_row_mobile.2" }
      ],
      "visible_if": "{{ section.settings.enable_slider }}"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:general.badge",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "100% Authentic"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:labels.icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.description",
          "default": "Shop with confidence, genuine and always original."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.trust_badges_2",
      "category": "t:general.branding",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "title": "100% Authentic",
            "text": "Shop with confidence, genuine and always original."
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Free Delivery",
            "text": "Save more with free shipping on every eligible order."
          }
        },
        {
          "type": "badge",
          "settings": {
            "title": "Support 24/7",
            "text": "Always here when you need us. Hassle free contact."
          }
        }
      ]
    }
  ]
}
{% endschema %}
