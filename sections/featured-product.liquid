{% javascript %}
(function () {
  'use strict';

  function initProduct(root) {
    if (root.dataset.lvPdpInit) return;
    root.dataset.lvPdpInit = '1';

    var SID = root.dataset.sectionId;

    if (!root.querySelector('.lv-pdp-form')) return;
    // NOTE: the "amount" placeholder below is a literal string token, not Liquid output
    // (javascript blocks never render Liquid) -- formatMoney() replaces it via regex.
    var moneyFmt = root.dataset.moneyFormat || '${{amount}}';

    var variantsEl = document.getElementById('lv-pdp-variants-' + SID);
    var variants = [];
    if (variantsEl) {
      try { variants = JSON.parse(variantsEl.textContent); } catch (e) { variants = []; }
    }

    var idInput = document.getElementById('variant-id-' + SID);
    var priceEl = document.getElementById('lv-pdp-price-' + SID);
    var atcBtn  = document.getElementById('lv-pdp-atc-' + SID);
    var availEl = document.getElementById('lv-pdp-availability-' + SID);
    var errorEl = document.getElementById('lv-pdp-error-' + SID);
    var form    = document.getElementById('featured-product-form-' + SID);
    var pickupEl = document.getElementById('lv-pdp-pickup-' + SID);
    var badgeEl = document.getElementById('lv-pdp-sale-badge-' + SID);
    var qtyInput = document.getElementById('qty-' + SID);
    var pickupLoadedFor = null;

    function loadPickupAvailability(variantId) {
      if (!pickupEl || !variantId || !window.fetch || variantId === pickupLoadedFor) return;
      pickupLoadedFor = variantId;
      var routeRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      fetch(routeRoot.replace(/\/$/, '') + '/variants/' + variantId + '/?section_id=pickup-availability')
        .then(function (r) { return r.ok ? r.text() : ''; })
        .then(function (html) { pickupEl.innerHTML = html.trim(); })
        .catch(function () { pickupEl.innerHTML = ''; });
    }

    function formatMoney(cents) {
      var amt = (cents / 100).toFixed(2);
      return moneyFmt.replace(/\{\{\s*amount\s*\}\}/, amt)
                     .replace(/\{\{\s*amount_no_decimals\s*\}\}/, Math.round(cents / 100))
                     .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, amt);
    }

    function getSelectedOptions() {
      var opts = [];
      root.querySelectorAll('.lv-pdp-option').forEach(function (fs) {
        var checked = fs.querySelector('.lv-pdp-opt-input:checked');
        if (checked) opts.push(checked.value);
      });
      return opts;
    }

    function findVariant(opts) {
      var exactAvailable = variants.find(function (v) {
        return v.available &&
          v.options.length === opts.length &&
          v.options.every(function (o, i) { return o === opts[i]; });
      });

      if (exactAvailable) return exactAvailable;

      return variants.find(function (v) {
        return v.options.length === opts.length &&
          v.options.every(function (o, i) { return o === opts[i]; });
      });
    }

    function updateGallery(variant) {
      if (!variant || !variant.featured_media) return;
      var mid = String(variant.featured_media.id);
      root.querySelectorAll('.lv-pdp-gallery__media').forEach(function (m) {
        m.hidden = m.dataset.mediaId !== mid;
      });
      root.querySelectorAll('.lv-pdp-gallery__thumb').forEach(function (t) {
        t.setAttribute('aria-current', t.dataset.thumbFor === mid ? 'true' : 'false');
      });
    }

    function updateQuantityRules(variant) {
      if (!qtyInput || !variant || !variant.quantity_rule) return;
      var rule = variant.quantity_rule;
      var min = rule.min || 1;
      var step = rule.increment || 1;

      qtyInput.min = min;
      qtyInput.step = step;
      if (rule.max) {
        qtyInput.max = rule.max;
      } else {
        qtyInput.removeAttribute('max');
      }
      if (!qtyInput.value || parseInt(qtyInput.value, 10) < min) {
        qtyInput.value = min;
      }
    }

    function updateUI(variant) {
      root.querySelectorAll('.lv-pdp-option').forEach(function (fs) {
        var checked = fs.querySelector('.lv-pdp-opt-input:checked');
        var label = fs.querySelector('.lv-pdp-option__selected');
        if (checked && label) label.textContent = checked.value;
      });

      if (!variant) {
        if (atcBtn) {
          atcBtn.disabled = true;
          atcBtn.querySelector('.lv-pdp-buy__text').textContent = root.dataset.labelUnavailable || 'Unavailable';
        }
        return;
      }

      idInput.value = variant.id;

      if (priceEl) {
        var html = '';
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          html += '<span class="lv-pdp-price__current is-sale">' + formatMoney(variant.price) + '</span>';
          html += '<span class="lv-pdp-price__compare">' + formatMoney(variant.compare_at_price) + '</span>';
        } else {
          html += '<span class="lv-pdp-price__current">' + formatMoney(variant.price) + '</span>';
        }
        if (root.dataset.taxesIncluded === 'true') {
          html += '<span class="lv-pdp-price__tax">' + (root.dataset.labelTaxIncluded || 'Tax included.') + '</span>';
        }
        var upm = variant.unit_price_measurement;
        if (variant.unit_price && upm) {
          var refUnit = (upm.reference_value && upm.reference_value !== 1)
            ? upm.reference_value + upm.reference_unit
            : upm.reference_unit;
          html += '<span class="lv-pdp-price__unit">' + formatMoney(variant.unit_price) + '/' + refUnit + '</span>';
        }
        priceEl.innerHTML = html;
      }

      if (badgeEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          var pct = Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price);
          badgeEl.textContent = pct + '% Off';
          badgeEl.hidden = false;
        } else {
          badgeEl.hidden = true;
        }
      }

      if (atcBtn) {
        atcBtn.disabled = !variant.available;
        atcBtn.querySelector('.lv-pdp-buy__text').textContent = variant.available
          ? (root.dataset.labelAddToCart || 'Add to Cart')
          : (root.dataset.labelSoldOut || 'Sold out');
      }

      if (availEl) {
        availEl.classList.toggle('is-out', !variant.available);
        var txt = availEl.querySelector('.lv-pdp-availability__text');
        if (txt) txt.textContent = variant.available
          ? (root.dataset.labelInStock || 'In stock')
          : (root.dataset.labelSoldOut || 'Sold out');
      }

      updateGallery(variant);
      updateQuantityRules(variant);

      if (variant.available) {
        loadPickupAvailability(variant.id);
      } else if (pickupEl) {
        pickupEl.innerHTML = '';
        pickupLoadedFor = null;
      }

      var url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url.toString());
    }

    root.querySelectorAll('.lv-pdp-opt-input').forEach(function (input) {
      input.addEventListener('change', function () {
        updateUI(findVariant(getSelectedOptions()));
      });
    });

    root.querySelectorAll('.lv-pdp-gallery__thumb').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var mid = thumb.dataset.thumbFor;
        root.querySelectorAll('.lv-pdp-gallery__media').forEach(function (m) {
          m.hidden = m.dataset.mediaId !== mid;
        });
        root.querySelectorAll('.lv-pdp-gallery__thumb').forEach(function (t) {
          t.setAttribute('aria-current', t === thumb ? 'true' : 'false');
        });
      });
    });

    var thumbsTrack = root.querySelector('[data-thumbs-track]');
    var arrowUp = root.querySelector('[data-thumbs-arrow="up"]');
    var arrowDown = root.querySelector('[data-thumbs-arrow="down"]');

    if (thumbsTrack && arrowUp && arrowDown) {
      var scrollThumbs = function (direction) {
        var firstThumb = thumbsTrack.querySelector('.lv-pdp-gallery__thumb');
        var step = firstThumb ? firstThumb.offsetHeight + 8 : 72;
        thumbsTrack.scrollBy({ top: direction * step * 3, behavior: 'smooth' });
      };

      var updateArrows = function () {
        var maxScroll = thumbsTrack.scrollHeight - thumbsTrack.clientHeight;
        arrowUp.hidden = thumbsTrack.scrollTop <= 0;
        arrowDown.hidden = thumbsTrack.scrollTop >= maxScroll - 1;
      };

      arrowUp.addEventListener('click', function () { scrollThumbs(-1); });
      arrowDown.addEventListener('click', function () { scrollThumbs(1); });
      thumbsTrack.addEventListener('scroll', updateArrows);
      window.addEventListener('resize', updateArrows);
      updateArrows();
    }

    var minus = root.querySelector('[data-qty-minus]');
    var plus = root.querySelector('[data-qty-plus]');

    function stepQty(direction) {
      if (!qtyInput) return;
      var min = parseInt(qtyInput.min, 10) || 1;
      var max = qtyInput.max ? parseInt(qtyInput.max, 10) : Infinity;
      var step = parseInt(qtyInput.step, 10) || 1;
      var current = parseInt(qtyInput.value, 10) || min;
      var next = current + (direction * step);
      qtyInput.value = Math.min(Math.max(next, min), max);
    }

    if (minus) minus.addEventListener('click', function () { stepQty(-1); });
    if (plus) plus.addEventListener('click', function () { stepQty(1); });

    if (form) {
      // Append the subscription app's selected selling plan, if any
      form.addEventListener('submit', function () {
        if (form.querySelector('input[name="selling_plan"]')) return;
        var selected = document.querySelector('[name="selling_plan"]:checked') ||
                       document.querySelector('select[name="selling_plan"]');
        if (!selected) return;
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'selling_plan';
        input.value = selected.value;
        form.appendChild(input);
      });

      form.addEventListener('submit', function (e) {
        if (!window.fetch) return;

        /* Resolve the currently selected variant immediately before submit. */
        if (variants.length && root.querySelector('.lv-pdp-opt-input')) {
          var selectedOptions = getSelectedOptions();
          var selectedVariant = findVariant(selectedOptions);

          if (!selectedVariant) {
            e.preventDefault();
            if (errorEl) {
              errorEl.textContent = root.dataset.labelUnavailable || 'Please select a valid variant.';
              errorEl.classList.add('is-visible');
            }
            return;
          }

          /* Always submit the exact variant selected in this section. */
          idInput.value = selectedVariant.id;
        }

        e.preventDefault();

        if (atcBtn) {
          atcBtn.classList.add('is-loading');
          atcBtn.disabled = true;
        }
        if (errorEl) errorEl.classList.remove('is-visible');

        /* Build FormData only after the final variant ID is set. */
        var formData = new FormData(form);

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
          body: formData
        })
        .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
        .then(function (res) {
          if (!res.ok) throw res.data;
          document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: { action: 'add' } }));
          document.dispatchEvent(new CustomEvent('cart:open'));
        })
        .catch(function (err) {
          if (errorEl) {
            errorEl.textContent = (err && err.description) ? err.description : 'Could not add to cart.';
            errorEl.classList.add('is-visible');
          }
        })
        .finally(function () {
          if (atcBtn) { atcBtn.classList.remove('is-loading'); atcBtn.disabled = false; }
        });
      });
    }

    // Only resolve a variant from options when option inputs exist.
    // Single-variant products keep the server-rendered id already in the
    // hidden input, so we must not run the "no variant" (disable) path.
    if (root.querySelector('.lv-pdp-opt-input')) {
      updateUI(findVariant(getSelectedOptions()));
    } else if (pickupEl && !(atcBtn && atcBtn.disabled)) {
      loadPickupAvailability(pickupEl.dataset.variantId);
    }
  }

  function initAll(scope) {
    (scope || document).querySelectorAll('.lv-pdp').forEach(initProduct);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { initAll(); });
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', function (e) {
    initAll(e.target);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "section section-featured-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Featured Product"
        }
      ]
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "placeholder_title",
          "label": "Placeholder title",
          "default": "Featured Product"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
