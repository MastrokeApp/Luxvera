{% comment %}
  Featured Product - block-based so blocks can be added/removed/reordered.
  Handles variants (native swatches), image gallery, quantity (incl. B2B
  quantity rules), dynamic checkout, availability, description, collapsible
  rows, trust badges, share links, plus custom liquid and app blocks. Also
  outputs variant JSON for the picker and Product JSON-LD (via the built-in
  `structured_data` filter) for SEO. Colors follow the selected scheme.

  Needs: main-product.css

  If no product is selected, a complete placeholder is rendered.
  All product information is controlled through reorderable blocks.

  NOTE: This section uses plain hardcoded English strings (no `| t` filters
  or `t:` schema keys), so it has no dependency on locales/*.json. If you
  need multi-language support later, these strings can be swapped back to
  translation keys.

  Note: "You May Also Like" is its own standalone section
  (sections/product-recommendations.liquid), not a block on this
  section -- see templates/featured_product.json for how it's wired in by default.
{% endcomment %}

{{ 'main-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_product = section.settings.product
  assign current_variant = blank

  if featured_product != blank
    assign current_variant = featured_product.selected_or_first_available_variant | default: featured_product.variants.first
  endif

  assign product_form_id = 'featured-product-form-' | append: section.id
-%}

<div
  class="lv-pdp color-{{ section.settings.color_scheme }}"
  id="lv-pdp-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="featured-product"
  data-money-format="{{ shop.money_format | escape }}"
  data-label-add-to-cart="Add to Cart"
  data-label-sold-out="Sold out"
  data-label-in-stock="In stock"
  data-label-unavailable="Unavailable"
  data-label-tax-included="Tax included."
  data-taxes-included="{{ cart.taxes_included }}"
  style="
    --lv-pdp-pt: {{ section.settings.padding_top_mobile }}px;
    --lv-pdp-pb: {{ section.settings.padding_bottom_mobile }}px;
    --lv-pdp-pt-d: {{ section.settings.padding_top_desktop }}px;
    --lv-pdp-pb-d: {{ section.settings.padding_bottom_desktop }}px;
  "
>

  {% if featured_product != blank %}
  <div class="lv-pdp-layout">
    {%- comment -%} ── MEDIA GALLERY ── {%- endcomment -%}
    <div class="lv-pdp-gallery" id="lv-pdp-gallery-{{ section.id }}">
      {%- if featured_product.media.size > 1 -%}
        <div class="lv-pdp-gallery__rail">
          <button type="button" class="lv-pdp-gallery__arrow lv-pdp-gallery__arrow--up" data-thumbs-arrow="up" aria-label="Previous images" hidden>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true"><path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div class="lv-pdp-gallery__thumbs" role="list" aria-label="Product media" data-thumbs-track>
            {%- for media in featured_product.media -%}
              <button
                type="button"
                class="lv-pdp-gallery__thumb"
                data-thumb-for="{{ media.id }}"
                aria-current="{% if media == current_variant.featured_media or forloop.first and current_variant.featured_media == blank %}true{% else %}false{% endif %}"
                aria-label="View image {{ forloop.index }} of {{ forloop.length }}"
              >
                <img src="{{ media.preview_image | image_url: width: 150 }}" alt="" width="75" height="75" loading="lazy">
              </button>
            {%- endfor -%}
          </div>

          <button type="button" class="lv-pdp-gallery__arrow lv-pdp-gallery__arrow--down" data-thumbs-arrow="down" aria-label="Next images">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}

      <div class="lv-pdp-gallery__main">
        {%- if featured_product.media.size > 0 -%}
          {%- for media in featured_product.media -%}
            <div
              class="lv-pdp-gallery__media lv-pdp-gallery__media--{{ media.media_type }}"
              data-media-id="{{ media.id }}"
              {% unless media == current_variant.featured_media or forloop.first and current_variant.featured_media == blank %}hidden{% endunless %}
            >
              {%- if media.media_type == 'image' -%}
                <img
                  src="{{ media.preview_image | image_url: width: 1000 }}"
                  alt="{{ media.preview_image.alt | escape | default: featured_product.title }}"
                  width="{{ media.preview_image.width }}"
                  height="{{ media.preview_image.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                >
              {%- else -%}
                {{ media | media_tag: image_size: '1000x' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="lv-pdp-gallery__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}

        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
          <span class="lv-pdp-badge" id="lv-pdp-sale-badge-{{ section.id }}" data-sale-badge>{{ pct }}% Off</span>
        {%- else -%}
          <span class="lv-pdp-badge" id="lv-pdp-sale-badge-{{ section.id }}" data-sale-badge hidden></span>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ── PRODUCT INFO (blocks) ── {%- endcomment -%}
    <div class="lv-pdp-info">

      {%- form 'product', featured_product, id: product_form_id, novalidate: 'novalidate', class: 'lv-pdp-form' -%}
        <input type="hidden" name="id" id="variant-id-{{ section.id }}" value="{{ current_variant.id }}">

        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}

            {%- when 'heading' -%}
              {% if block.settings.heading != blank %}
                <div class="lv-pdp-block lv-pdp-custom-heading" {{ block.shopify_attributes }}>
                  <h2>{{ block.settings.heading }}</h2>
                </div>
              {% endif %}

            {%- when 'vendor' -%}
              {%- if featured_product.vendor != blank -%}
                <p class="lv-pdp-block lv-pdp-vendor" {{ block.shopify_attributes }}>{{ featured_product.vendor }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="lv-pdp-block lv-pdp-title" {{ block.shopify_attributes }}>{{ featured_product.title }}</h1>

            {%- when '@app' -%}
              <div class="lv-pdp-block lv-pdp-app-block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {%- when 'price' -%}
              <div class="lv-pdp-block lv-pdp-price" id="lv-pdp-price-{{ section.id }}" role="status" aria-live="polite" {{ block.shopify_attributes }}>
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  <span class="lv-pdp-price__current is-sale">{{ current_variant.price | money }}</span>
                  <span class="lv-pdp-price__compare">{{ current_variant.compare_at_price | money }}</span>
                {%- else -%}
                  <span class="lv-pdp-price__current">{{ current_variant.price | money }}</span>
                {%- endif -%}
                {%- if cart.taxes_included -%}<span class="lv-pdp-price__tax">Tax included.</span>{%- endif -%}
                {%- if current_variant.unit_price_measurement -%}
                  <span class="lv-pdp-price__unit" id="lv-pdp-unit-price-{{ section.id }}">{{ current_variant.unit_price | money | unit_price_with_measurement: current_variant.unit_price_measurement }}</span>
                {%- else -%}
                  <span class="lv-pdp-price__unit" id="lv-pdp-unit-price-{{ section.id }}" hidden></span>
                {%- endif -%}
              </div>
              <div class="lv-pdp-block lv-pdp-installments">
                {{ form | payment_terms }}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless featured_product.has_only_default_variant -%}
                <div class="lv-pdp-block lv-pdp-variant-picker" {{ block.shopify_attributes }}>
                  {%- for option in featured_product.options_with_values -%}
                    <fieldset class="lv-pdp-option" data-option-position="{{ option.position }}">
                      <legend class="lv-pdp-option__label">
                        {{ option.name }}:
                        <span class="lv-pdp-option__selected" data-selected-for="{{ option.position }}">{% assign option_index = option.position | minus: 1 %}{{ current_variant.options[option_index] }}</span>
                      </legend>
                      <div class="lv-pdp-option__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                          <input
                            type="radio"
                            class="lv-pdp-opt-input"
                            id="{{ input_id }}"
                            name="option-{{ option.position }}"
                            value="{{ value | escape }}"
                            data-option-position="{{ option.position }}"
                            {% assign option_index = option.position | minus: 1 %}
                             {% if current_variant.options[option_index] == value %}checked{% endif %}
                          >
                          {%- if value.swatch.image -%}
                            <label class="lv-pdp-opt-label lv-pdp-swatch" for="{{ input_id }}" title="{{ value | escape }}">
                              <span class="lv-pdp-swatch__img" style="background-image:url({{ value.swatch.image | image_url: width: 100 }})"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {%- elsif value.swatch.color -%}
                            <label class="lv-pdp-opt-label lv-pdp-swatch" for="{{ input_id }}" title="{{ value | escape }}">
                              <span class="lv-pdp-swatch__color" style="background:{{ value.swatch.color }}"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label class="lv-pdp-opt-label lv-pdp-pill" for="{{ input_id }}">{{ value }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'availability' -%}
              <p class="lv-pdp-block lv-pdp-availability{% unless current_variant.available %} is-out{% endunless %}" id="lv-pdp-availability-{{ section.id }}" role="status" aria-live="polite" {{ block.shopify_attributes }}>
                <span class="lv-pdp-availability__dot"></span>
                <span class="lv-pdp-availability__text">{% if current_variant.available %}In stock{% else %}Sold out{% endif %}</span>
              </p>

            {%- when 'quantity' -%}
              {%- liquid
                assign qty_min = current_variant.quantity_rule.min | default: 1
                assign qty_max = current_variant.quantity_rule.max
                assign qty_step = current_variant.quantity_rule.increment | default: 1
              -%}
              <div class="lv-pdp-block lv-pdp-qty" {{ block.shopify_attributes }}>
                <label class="lv-pdp-qty__label" for="qty-{{ section.id }}">Quantity</label>
                <div class="lv-pdp-qty__controls">
                  <button type="button" class="lv-pdp-qty__btn" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                  <input
                    type="number"
                    id="qty-{{ section.id }}"
                    name="quantity"
                    value="{{ qty_min }}"
                    min="{{ qty_min }}"
                    {% if qty_max %}max="{{ qty_max }}"{% endif %}
                    step="{{ qty_step }}"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    class="lv-pdp-qty__input"
                    aria-label="Quantity"
                    data-qty-min="{{ qty_min }}"
                    data-qty-max="{{ qty_max }}"
                    data-qty-step="{{ qty_step }}"
                  >
                  <button type="button" class="lv-pdp-qty__btn" data-qty-plus aria-label="Increase quantity">+</button>
                </div>
                {%- if qty_min > 1 or qty_max or qty_step > 1 -%}
                  <p class="lv-pdp-qty__rules" id="lv-pdp-qty-rules-{{ section.id }}">
                    {%- if qty_min > 1 -%}Minimum order: {{ qty_min }}{%- endif -%}
                    {%- if qty_max -%} Maximum order: {{ qty_max }}{%- endif -%}
                    {%- if qty_step > 1 -%} Sold in multiples of {{ qty_step }}{%- endif -%}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'buy_buttons' -%}
              <div class="lv-pdp-block lv-pdp-buy" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  class="lv-pdp-buy__atc"
                  id="lv-pdp-atc-{{ section.id }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span class="lv-pdp-buy__text">{% if current_variant.available %}Add to Cart{% else %}Sold out{% endif %}</span>
                  <span class="lv-pdp-buy__loading">Adding...</span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}

                <p class="lv-pdp-buy__error" id="lv-pdp-error-{{ section.id }}" role="alert"></p>

                <div class="lv-pdp-pickup" id="lv-pdp-pickup-{{ section.id }}" data-variant-id="{{ current_variant.id }}"></div>
              </div>

            {%- when 'description' -%}
              {%- if featured_product.description != blank -%}
                <details class="lv-pdp-block lv-pdp-collapsible" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="lv-pdp-collapsible__summary">
                    {{ block.settings.heading | default: 'Description' }}
                    <svg class="lv-pdp-collapsible__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </summary>
                  <div class="lv-pdp-collapsible__body rte">{{ featured_product.description }}</div>
                </details>
              {%- endif -%}

            {%- when 'collapsible_row' -%}
              {%- if block.settings.heading != blank -%}
                <details class="lv-pdp-block lv-pdp-collapsible" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="lv-pdp-collapsible__summary">
                    {{ block.settings.heading }}
                    <svg class="lv-pdp-collapsible__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </summary>
                  <div class="lv-pdp-collapsible__body rte">
                    {%- if block.settings.content != blank -%}{{ block.settings.content }}{%- endif -%}
                    {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                  </div>
                </details>
              {%- endif -%}

            {%- when 'trust' -%}
              <ul class="lv-pdp-block lv-pdp-trust" {{ block.shopify_attributes }}>
                {%- if block.settings.line_1 != blank -%}<li class="lv-pdp-trust__item"><svg class="lv-pdp-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>{{ block.settings.line_1 }}</li>{%- endif -%}
                {%- if block.settings.line_2 != blank -%}<li class="lv-pdp-trust__item"><svg class="lv-pdp-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-6 9 6v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>{{ block.settings.line_2 }}</li>{%- endif -%}
                {%- if block.settings.line_3 != blank -%}<li class="lv-pdp-trust__item"><svg class="lv-pdp-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg>{{ block.settings.line_3 }}</li>{%- endif -%}
              </ul>

            {%- when 'share' -%}
              {%- assign share_url = shop.url | append: featured_product.url | url_encode -%}
              <div class="lv-pdp-block lv-pdp-share" {{ block.shopify_attributes }}>
                <span class="lv-pdp-share__label">{{ block.settings.label | default: 'Share' }}</span>
                <a class="lv-pdp-share__btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
                <a class="lv-pdp-share__btn" href="https://pinterest.com/pin/create/button/?url={{ share_url }}&amp;description={{ featured_product.title | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Pinterest"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.4 9.3-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.6c0-1.5.9-2.6 1.9-2.6.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.5-.2 1 .5 1.9 1.6 1.9 1.9 0 3.1-2.4 3.1-5.2 0-2.2-1.5-3.7-3.6-3.7-2.4 0-3.8 1.8-3.8 3.7 0 .7.3 1.5.6 1.9.1.1.1.2.1.3l-.2 1c0 .2-.2.2-.3.1-1.1-.5-1.7-2.1-1.7-3.4 0-2.7 2-5.2 5.7-5.2 3 0 5.3 2.1 5.3 5 0 3-1.9 5.4-4.5 5.4-.9 0-1.7-.5-2-1l-.5 2.1c-.2.8-.7 1.7-1.1 2.3.8.3 1.7.4 2.6.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg></a>
                <a class="lv-pdp-share__btn" href="mailto:?subject={{ featured_product.title | url_encode }}&amp;body={{ share_url }}" aria-label="Share by email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></a>
              </div>

            {%- when 'custom_liquid' -%}
              <div class="lv-pdp-block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- endcase -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endform -%}
    </div>{%- comment -%} /lv-pdp-info {%- endcomment -%}
  </div>

  {% else %}
    <div class="lv-pdp-layout lv-pdp-layout--placeholder">

      <div class="lv-pdp-gallery">
        <div class="lv-pdp-gallery__main">
          <div class="lv-pdp-gallery__media">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      </div>

      <div class="lv-pdp-info">
        {% for block in section.blocks %}
          {% case block.type %}

            {% when 'heading' %}
              {% if block.settings.heading != blank %}
                <div class="lv-pdp-block lv-pdp-custom-heading" {{ block.shopify_attributes }}>
                  <h2>{{ block.settings.heading }}</h2>
                </div>
              {% endif %}

            {% when 'vendor' %}
              <p class="lv-pdp-block lv-pdp-vendor" {{ block.shopify_attributes }}>Example Brand</p>

            {% when 'title' %}
              <h1 class="lv-pdp-block lv-pdp-title" {{ block.shopify_attributes }}>{{ block.settings.placeholder_title | default: 'Featured Product' }}</h1>

            {% when 'price' %}
              <div class="lv-pdp-block lv-pdp-price" {{ block.shopify_attributes }}>
                <span class="lv-pdp-price__current">$50.00</span>
              </div>

            {% when 'variant_picker' %}
              {% if block.settings.show_placeholder %}
                <div class="lv-pdp-block lv-pdp-variant-picker lv-pdp-variant-picker--placeholder" {{ block.shopify_attributes }}>
                  <fieldset class="lv-pdp-option">
                    <legend class="lv-pdp-option__label">
                      {{ block.settings.placeholder_label | default: 'Size' }}:
                      <span class="lv-pdp-option__selected">Small</span>
                    </legend>
                    <div class="lv-pdp-option__values">
                      <input type="radio" class="lv-pdp-opt-input" id="placeholder-opt-{{ section.id }}-0" name="placeholder-option-{{ section.id }}" checked tabindex="-1" aria-hidden="true">
                      <label class="lv-pdp-opt-label lv-pdp-pill" for="placeholder-opt-{{ section.id }}-0">Small</label>

                      <input type="radio" class="lv-pdp-opt-input" id="placeholder-opt-{{ section.id }}-1" name="placeholder-option-{{ section.id }}" tabindex="-1" aria-hidden="true">
                      <label class="lv-pdp-opt-label lv-pdp-pill" for="placeholder-opt-{{ section.id }}-1">Medium</label>

                      <input type="radio" class="lv-pdp-opt-input" id="placeholder-opt-{{ section.id }}-2" name="placeholder-option-{{ section.id }}" tabindex="-1" aria-hidden="true">
                      <label class="lv-pdp-opt-label lv-pdp-pill" for="placeholder-opt-{{ section.id }}-2">Large</label>
                    </div>
                  </fieldset>
                </div>
              {% endif %}

            {% when 'availability' %}
              <p class="lv-pdp-block lv-pdp-availability" {{ block.shopify_attributes }}>
                <span class="lv-pdp-availability__dot"></span>
                <span class="lv-pdp-availability__text">In stock</span>
              </p>

            {% when 'quantity' %}
              <div class="lv-pdp-block lv-pdp-qty" {{ block.shopify_attributes }}>
                <label class="lv-pdp-qty__label">Quantity</label>
                <div class="lv-pdp-qty__controls">
                  <button type="button" class="lv-pdp-qty__btn" disabled>&minus;</button>
                  <input type="number" value="1" min="1" class="lv-pdp-qty__input" disabled>
                  <button type="button" class="lv-pdp-qty__btn" disabled>+</button>
                </div>
              </div>

            {% when 'buy_buttons' %}
              <div class="lv-pdp-block lv-pdp-buy" {{ block.shopify_attributes }}>
                <button type="button" class="lv-pdp-buy__atc" disabled>
                  {{ block.settings.add_to_cart_text | default: 'Add to cart' }}
                </button>
                {% if block.settings.show_dynamic_checkout %}
                  <button type="button" class="lv-pdp-placeholder-buy" disabled>
                    {{ block.settings.buy_now_text | default: 'Buy it now' }}
                  </button>
                {% endif %}
              </div>

            {% when 'description' %}
              <details class="lv-pdp-block lv-pdp-collapsible" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="lv-pdp-collapsible__summary">
                  {{ block.settings.heading | default: 'Description' }}
                  <svg class="lv-pdp-collapsible__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </summary>
                <div class="lv-pdp-collapsible__body rte">
                  <p>Select a product in the Theme Editor to display the product description.</p>
                </div>
              </details>

            {% when 'collapsible_row' %}
              {% if block.settings.heading != blank %}
                <details class="lv-pdp-block lv-pdp-collapsible" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="lv-pdp-collapsible__summary">
                    {{ block.settings.heading }}
                    <svg class="lv-pdp-collapsible__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <line x1="12" y1="5" x2="12" y2="19"/>
                      <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </summary>
                  <div class="lv-pdp-collapsible__body rte">
                    {% if block.settings.content != blank %}{{ block.settings.content }}{% else %}<p>Add additional product information here.</p>{% endif %}
                  </div>
                </details>
              {% endif %}

            {% when 'trust' %}
              <ul class="lv-pdp-block lv-pdp-trust" {{ block.shopify_attributes }}>
                {% if block.settings.line_1 != blank %}<li class="lv-pdp-trust__item"><svg class="lv-pdp-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>{{ block.settings.line_1 }}</li>{% endif %}
                {% if block.settings.line_2 != blank %}<li class="lv-pdp-trust__item"><svg class="lv-pdp-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l9-6 9 6v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>{{ block.settings.line_2 }}</li>{% endif %}
                {% if block.settings.line_3 != blank %}<li class="lv-pdp-trust__item"><svg class="lv-pdp-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg>{{ block.settings.line_3 }}</li>{% endif %}
              </ul>

            {% when 'share' %}
              <div class="lv-pdp-block lv-pdp-share" {{ block.shopify_attributes }}>
                <span class="lv-pdp-share__label">{{ block.settings.label | default: 'Share' }}</span>
                <span class="lv-pdp-share__placeholder-links">
                  <span class="lv-pdp-share__placeholder-icon" aria-hidden="true" title="Facebook">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  </span>
                  <span class="lv-pdp-share__placeholder-icon" aria-hidden="true" title="Pinterest">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.4 9.3-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.6c0-1.5.9-2.6 1.9-2.6.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.5-.2 1 .5 1.9 1.6 1.9 1.9 0 3.1-2.4 3.1-5.2 0-2.2-1.5-3.7-3.6-3.7-2.4 0-3.8 1.8-3.8 3.7 0 .7.3 1.5.6 1.9.1.1.1.2.1.3l-.2 1c0 .2-.2.2-.3.1-1.1-.5-1.7-2.1-1.7-3.4 0-2.7 2-5.2 5.7-5.2 3 0 5.3 2.1 5.3 5 0 3-1.9 5.4-4.5 5.4-.9 0-1.7-.5-2-1l-.5 2.1c-.2.8-.7 1.7-1.1 2.3.8.3 1.7.4 2.6.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
                  </span>
                  <span class="lv-pdp-share__placeholder-icon" aria-hidden="true" title="Email">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                  </span>
                </span>
              </div>

            {% when 'custom_liquid' %}
              <div class="lv-pdp-block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {% when '@app' %}
              <div class="lv-pdp-block lv-pdp-app-block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

          {% endcase %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {%- comment -%} Variant data for the picker script (guard against a stray "</script>" inside variant JSON breaking out of the tag) {%- endcomment -%}
  {% if featured_product != blank %}
    <script type="application/json" id="lv-pdp-variants-{{ section.id }}">{{ featured_product.variants | json | replace: '</script', '<\/script' }}</script>
    <script type="application/ld+json">{{ featured_product | structured_data }}</script>
  {% endif %}
</div>

