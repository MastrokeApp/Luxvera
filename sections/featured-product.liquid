        {
          "type": "checkbox",
          "id": "show_placeholder",
          "label": "Show placeholder when no product is selected",
          "default": true
        },
        {
          "type": "text",
          "id": "placeholder_label",
          "label": "Placeholder option label",
          "default": "Size"
        }
      ]
    },
    {
      "type": "availability",
      "name": "Availability",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Quantity selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true,
          "info": "Shows Shop Pay, PayPal, etc. when available"
        },
        {
          "type": "text",
          "id": "add_to_cart_text",
          "label": "Add to cart text",
          "default": "Add to cart"
        },
        {
          "type": "text",
          "id": "buy_now_text",
          "label": "Buy now placeholder text",
